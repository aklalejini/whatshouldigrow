---
const { title, text, url, imageUrl = "", placement = "top" } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedShareText = encodeURIComponent(`${title} ${url}`);
const encodedImageUrl = encodeURIComponent(imageUrl);
const emailBody = encodeURIComponent(`${title}\n\n${text}\n\n${url}`);
const className = placement === "footer" ? "article-share article-share-footer" : "article-share";
const shareLinks = [
  {
    label: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    external: true
  },
  {
    label: "Pinterest",
    href: `https://pinterest.com/pin/create/button/?url=${encodedUrl}&media=${encodedImageUrl}&description=${encodedTitle}`,
    external: true
  },
  {
    label: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    external: true
  },
  {
    label: "X",
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    external: true
  },
  {
    label: "Text",
    href: `sms:?&body=${encodedShareText}`,
    external: false
  },
  {
    label: "WhatsApp",
    href: `https://wa.me/?text=${encodedShareText}`,
    external: true
  },
  {
    label: "Email",
    href: `mailto:?subject=${encodedTitle}&body=${emailBody}`,
    external: false
  }
];
---

<div
  class={className}
  aria-label="Share this article"
  data-share-root
>
  <span class="article-share-label">Share</span>
  <button
    class="article-share-button is-native"
    type="button"
    data-native-share
    data-share-title={title}
    data-share-text={text}
    data-share-url={url}
    title="Share to apps on this device"
  >
    Share apps
  </button>
  {shareLinks.map((link) => (
    <a
      class="article-share-button"
      href={link.href}
      target={link.external ? "_blank" : undefined}
      rel={link.external ? "noopener noreferrer" : undefined}
    >
      {link.label}
    </a>
  ))}
  <button
    class="article-share-button"
    type="button"
    data-copy-share
    data-share-url={url}
  >
    Copy link
  </button>
  <span class="article-share-status" data-share-status role="status" aria-live="polite"></span>
</div>

<script is:inline>
  (function () {
    if (window.__plantByZipArticleShareReady) return;
    window.__plantByZipArticleShareReady = true;

    function closestShareRoot(element) {
      while (element && element !== document) {
        if (element.getAttribute && element.hasAttribute("data-share-root")) {
          return element;
        }
        element = element.parentNode;
      }
      return null;
    }

    function statusFor(button) {
      var root = closestShareRoot(button);
      return root ? root.querySelector("[data-share-status]") : null;
    }

    function setShareStatus(button, message) {
      var status = statusFor(button);
      if (!status) return;

      status.textContent = message;
      if (message) {
        window.setTimeout(function () {
          if (status.textContent === message) {
            status.textContent = "";
          }
        }, 2400);
      }
    }

    function copyWithTextarea(text) {
      var field = document.createElement("textarea");
      field.value = text;
      field.setAttribute("readonly", "");
      field.style.position = "fixed";
      field.style.left = "-9999px";
      field.style.top = "0";
      document.body.appendChild(field);
      field.focus();
      field.select();
      field.setSelectionRange(0, field.value.length);
      var copied = document.execCommand("copy");
      field.remove();

      if (!copied) {
        throw new Error("Copy command failed");
      }
    }

    function copyText(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(text).catch(function () {
          copyWithTextarea(text);
        });
      }

      return new Promise(function (resolve, reject) {
        try {
          copyWithTextarea(text);
          resolve();
        } catch (error) {
          reject(error);
        }
      });
    }

    function resetCopyLabel(button, originalLabel) {
      window.setTimeout(function () {
        button.textContent = originalLabel;
        button.classList.remove("is-copied");
      }, 1800);
    }

    document.addEventListener("click", function (event) {
      var button = event.target && event.target.closest
        ? event.target.closest("[data-native-share], [data-copy-share]")
        : null;
      if (!button) return;

      if (button.hasAttribute("data-native-share")) {
        if (navigator.share) {
          navigator.share({
            title: button.getAttribute("data-share-title") || document.title,
            text: button.getAttribute("data-share-text") || "",
            url: button.getAttribute("data-share-url") || window.location.href
          }).catch(function (error) {
            if (error && error.name === "AbortError") return;
            copyText(button.getAttribute("data-share-url") || window.location.href)
              .then(function () {
                setShareStatus(button, "Link copied");
              })
              .catch(function () {
                setShareStatus(button, "Share unavailable");
              });
          });
          return;
        }

        copyText(button.getAttribute("data-share-url") || window.location.href)
          .then(function () {
            setShareStatus(button, "Link copied");
          })
          .catch(function () {
            setShareStatus(button, "Share unavailable");
          });
        return;
      }

      if (button.hasAttribute("data-copy-share")) {
        var originalLabel = button.textContent ? button.textContent.trim() : "Copy link";
        copyText(button.getAttribute("data-share-url") || window.location.href)
          .then(function () {
            button.textContent = "Copied";
            button.classList.add("is-copied");
            setShareStatus(button, "Link copied");
            resetCopyLabel(button, originalLabel);
          })
          .catch(function () {
            setShareStatus(button, "Copy failed");
          });
      }
    });
  })();
</script>
