---
import plantPhotoEntries from "../data/plantPhotos.json";
import {
  plantKind,
  plantPrimaryPhotoEntry,
  plantRealPhotoStyle,
  plantUrl,
  sentenceCase
} from "../lib/plantUtils";
import {
  zonePageFaqs,
  zonePageAdvice,
  zonePageHighlightGroups,
  zonePagePlanningWindows,
  zoneProfileForTarget,
  zonePageStats,
  zonePlantSummary
} from "../lib/zonePageData";

const { target, entries, relatedTargets = [] } = Astro.props;
const featuredEntries = entries.slice(0, 24);
const stats = zonePageStats(entries);
const profile = zoneProfileForTarget(target);
const advice = zonePageAdvice(target);
const planningWindows = zonePagePlanningWindows(target);
const highlightGroups = zonePageHighlightGroups(target, entries);
const faqs = zonePageFaqs(target, entries);
const familyPath = target.family === "what-to-plant-now" ? target.path : `/${target.family}/`;
---

<article class="hub-page zone-intent-page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Plant by ZIP</a>
    <span aria-hidden="true">/</span>
    <a href={familyPath}>{target.family.replaceAll("-", " ")}</a>
    <span aria-hidden="true">/</span>
    <span>{target.zone}</span>
  </nav>

  <header class="hub-hero zone-intent-hero">
    <div>
      <p class="eyebrow">{target.eyebrow}</p>
      <h1>{target.title}</h1>
      <p>{target.summary}</p>
      <div class="hub-actions">
        <a class="plant-page-action is-primary" href={target.ctaHref}>{target.ctaLabel}</a>
        <a class="plant-page-action is-secondary" href="/#screener">Open plant screener</a>
      </div>
    </div>
    <dl class="hub-stats" aria-label={`${target.shortTitle} collection stats`}>
      <div>
        <dt>Zone fits</dt>
        <dd>{stats.matches}</dd>
      </div>
      <div>
        <dt>Plant forms</dt>
        <dd>{stats.types}</dd>
      </div>
      <div>
        <dt>Timing data</dt>
        <dd>{stats.sourced}</dd>
      </div>
      <div>
        <dt>Low water</dt>
        <dd>{stats.lowWater}</dd>
      </div>
    </dl>
  </header>

  <section class="hub-section" aria-labelledby="zone-advice-title">
    <div class="hub-section-head">
      <div>
        <p class="eyebrow">How to use this page</p>
        <h2 id="zone-advice-title">Start here, then verify your exact ZIP.</h2>
      </div>
      <p>
        These pages are generated from Plant by ZIP's plant database and metric fields. They are meant to be useful
        zone-level guides, not duplicate pages for every ZIP code.
      </p>
    </div>
    <div class="zone-advice-grid">
      {advice.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="hub-section zone-snapshot-section" aria-labelledby="zone-snapshot-title">
    <div class="hub-section-head">
      <div>
        <p class="eyebrow">Zone snapshot</p>
        <h2 id="zone-snapshot-title">Zone {target.zone} in practical garden terms</h2>
      </div>
      <p>
        Hardiness zones describe winter lows. The planning value comes from combining that winter-low gate
        with frost timing, summer heat, moisture, and plant-specific needs.
      </p>
    </div>
    <dl class="zone-snapshot-grid">
      <div>
        <dt>Winter-low range</dt>
        <dd>{profile.tempRange}</dd>
      </div>
      <div>
        <dt>Last frost estimate</dt>
        <dd>{profile.lastFrost}</dd>
      </div>
      <div>
        <dt>First frost estimate</dt>
        <dd>{profile.firstFrost}</dd>
      </div>
      <div>
        <dt>Season length</dt>
        <dd>{profile.seasonLength}</dd>
      </div>
      <div>
        <dt>Summer heat</dt>
        <dd>{profile.heatCue}</dd>
      </div>
      <div>
        <dt>Fruit chill estimate</dt>
        <dd>{profile.chillCue}</dd>
      </div>
    </dl>
    <p class="zone-snapshot-note">{profile.regionCue}. {profile.caution}</p>
  </section>

  <section class="hub-section" aria-labelledby="zone-windows-title">
    <div class="hub-section-head">
      <div>
        <p class="eyebrow">Planning windows</p>
        <h2 id="zone-windows-title">What the timing data means</h2>
      </div>
      <p>
        Use these as zone-level guardrails. The ZIP calendar and individual plant profiles narrow them down.
      </p>
    </div>
    <div class="zone-window-grid">
      {planningWindows.map((item) => (
        <article>
          <span>{item.label}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="hub-section" aria-labelledby="zone-shortlists-title">
    <div class="hub-section-head">
      <div>
        <p class="eyebrow">Intent shortlists</p>
        <h2 id="zone-shortlists-title">Start with the plants that match the job</h2>
      </div>
      <p>
        Each group is pulled from the same ranked database results and links directly to full plant profiles.
      </p>
    </div>
    <div class="zone-shortlist-grid">
      {highlightGroups.map((group) => (
        <article>
          <h3>{group.title}</h3>
          <p>{group.description}</p>
          <ol>
            {group.entries.map(({ plant, metrics, timing }) => (
              <li>
                <a href={plantUrl(plant)}>{plant.name}</a>
                <span>{zonePlantSummary(plant, metrics, timing)}</span>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <section class="hub-section" aria-labelledby="zone-featured-title">
    <div class="hub-section-head">
      <div>
        <p class="eyebrow">Database-backed picks</p>
        <h2 id="zone-featured-title">{featuredEntries.length} useful options for zone {target.zone}</h2>
      </div>
      <p>
        Sorted by hardiness fit, sourced planning data, water practicality, and relevance to this page's intent.
      </p>
    </div>

    <div class="hub-card-grid">
      {featuredEntries.map(({ plant, metrics, timing }) => {
        const photoEntry = plantPrimaryPhotoEntry(plant, plantPhotoEntries);
        const hasImage = Boolean(photoEntry?.primary?.src);
        const kind = plantKind(plant);
        return (
          <a class="hub-plant-card zone-plant-card" href={plantUrl(plant)}>
            <figure
              class={`plant-visual hub-plant-visual ${kind} ${hasImage ? "real-photo" : ""}`}
              aria-label={photoEntry?.primary?.alt ?? `${plant.name} plant photo`}
              style={plantRealPhotoStyle(photoEntry)}
            >
              {!hasImage && <span class="plant-visual-icon"></span>}
            </figure>
            <div>
              <span>{sentenceCase(plant.type)}</span>
              <h3>{plant.name}</h3>
              <p>{zonePlantSummary(plant, metrics, timing)}</p>
              <div class="hub-card-tags">
                <span>{plant.harvest}</span>
                <span>{plant.sun.map(sentenceCase).join("/")}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section class="hub-section zone-faq-section" aria-labelledby="zone-faq-title">
    <div class="hub-section-head">
      <div>
        <p class="eyebrow">Practical questions</p>
        <h2 id="zone-faq-title">Read this before you plant</h2>
      </div>
      <p>
        These answers keep the zone pages honest: they are useful planning pages, not substitutes for local
        observation, extension advice, or the ZIP-level matcher.
      </p>
    </div>
    <div class="zone-faq-grid">
      {faqs.map((item) => (
        <article>
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="hub-section hub-crosslinks" aria-labelledby="zone-crosslinks-title">
    <div class="hub-section-head">
      <div>
        <p class="eyebrow">Related zone guides</p>
        <h2 id="zone-crosslinks-title">More crawlable planning paths</h2>
      </div>
      <p>These pages expose high-intent zone and season collections without creating thin ZIP-code permutations.</p>
    </div>
    <div class="home-hub-grid">
      {relatedTargets.map((link) => (
        <a href={link.path}>
          <span>{link.shortTitle}</span>
          <strong>{link.description}</strong>
        </a>
      ))}
    </div>
  </section>
</article>
