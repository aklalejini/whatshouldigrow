---
import plantArtEntries from "../data/plantArt.json";
import plantMetrics from "../data/plantMetrics.json";
import plants from "../data/plants.json";
import {
  DEFAULT_SOCIAL_IMAGE,
  SITE_NAME,
  SITE_URL,
  siteUrl
} from "../lib/site";
import {
  HUB_PAGES,
  hubInternalLinks,
  hubPlantSummary,
  hubPlantTags,
  itemListForPlants,
  plantsForHub
} from "../lib/hubData";
import {
  isSourcedValue,
  plantArtEntry,
  plantKind,
  plantPhotoStyle,
  plantUrl,
  sentenceCase
} from "../lib/plantUtils";
import "../styles/global.css";

export function getStaticPaths() {
  return HUB_PAGES.map((hub) => ({
    params: { hub: hub.slug },
    props: { hub }
  }));
}

const { hub } = Astro.props;
const canonicalUrl = siteUrl(hub.path);
const socialImageUrl = siteUrl(DEFAULT_SOCIAL_IMAGE);
const hubEntries = plantsForHub(hub, plants, plantMetrics);
const featuredEntries = hubEntries.slice(0, 24);
const sourcedYieldCount = hubEntries.filter(({ metrics }) => isSourcedValue(metrics.display?.yieldLbs)).length;
const sourceReadyCount = hubEntries.filter(({ metrics }) => isSourcedValue(metrics.display?.firstOutput)).length;
const hubLinks = hubInternalLinks().filter((link) => link.href !== hub.path);
const tabClass = (slug) => slug === hub.slug ? "site-tab is-active" : "site-tab";
const tabCurrent = (slug) => slug === hub.slug ? "page" : undefined;
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: SITE_NAME,
      item: SITE_URL
    },
    {
      "@type": "ListItem",
      position: 2,
      name: hub.shortTitle,
      item: canonicalUrl
    }
  ]
};
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: hub.title,
  description: hub.description,
  url: canonicalUrl,
  numberOfItems: featuredEntries.length,
  itemListElement: itemListForPlants(featuredEntries, SITE_URL)
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={hub.description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${hub.title} | ${SITE_NAME}`} />
    <meta property="og:description" content={hub.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${hub.title} | ${SITE_NAME}`} />
    <meta name="twitter:description" content={hub.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,750&family=Inter:wght@400;500;650;750;850&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/plantbyzip-icon.png" />
    <link rel="apple-touch-icon" href="/brand/plantbyzip-icon.png" />
    <title>{hub.title} | {SITE_NAME}</title>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)}></script>
  </head>
  <body>
    <main class="app-shell">
      <nav class="site-tabs" aria-label="Primary sections">
        <a class="site-tab" href="/">Plant matcher</a>
        <a class={tabClass("planting-calendar")} aria-current={tabCurrent("planting-calendar")} href="/planting-calendar/">Calendar</a>
        <a class={tabClass("native-plants")} aria-current={tabCurrent("native-plants")} href="/native-plants/">Native plants</a>
        <a class={tabClass("fruit-trees")} aria-current={tabCurrent("fruit-trees")} href="/fruit-trees/">Fruit trees</a>
        <a class="site-tab" href="/blog/">Blog</a>
      </nav>

      <article class="hub-page">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Plant by ZIP</a>
          <span aria-hidden="true">/</span>
          <span>{hub.shortTitle}</span>
        </nav>

        <header class="hub-hero">
          <div>
            <p class="eyebrow">{hub.eyebrow}</p>
            <h1>{hub.title}</h1>
            <p>{hub.summary}</p>
            <div class="hub-actions">
              <a class="plant-page-action is-primary" href={hub.ctaHref}>{hub.ctaLabel}</a>
              <a class="plant-page-action is-secondary" href="/#screener">Open plant screener</a>
            </div>
          </div>
          <dl class="hub-stats" aria-label={`${hub.shortTitle} collection stats`}>
            <div>
              <dt>{hub.filterLabel}</dt>
              <dd>{hubEntries.length}</dd>
            </div>
            <div>
              <dt>Timing cues</dt>
              <dd>{sourceReadyCount}</dd>
            </div>
            <div>
              <dt>Sourced yield rows</dt>
              <dd>{sourcedYieldCount}</dd>
            </div>
          </dl>
        </header>

        <section class="hub-section" aria-labelledby="hub-featured-title">
          <div class="hub-section-head">
            <div>
              <p class="eyebrow">Browse profiles</p>
              <h2 id="hub-featured-title">{featuredEntries.length} useful starting points</h2>
            </div>
            <p>
              Sorted by sourced planning data, fit signals, and practical usefulness. Use a ZIP lookup before buying,
              especially near a plant's zone edge.
            </p>
          </div>

          <div class="hub-card-grid">
            {featuredEntries.map(({ plant, metrics }) => {
              const artEntry = plantArtEntry(plant, plantArtEntries);
              const hasImage = Boolean(artEntry?.image);
              const kind = plantKind(plant);
              const tags = hubPlantTags(plant);
              return (
                <a class="hub-plant-card" href={plantUrl(plant)}>
                  <figure
                    class={`plant-visual hub-plant-visual ${kind} ${artEntry?.id ?? "generic-fruit"} ${hasImage ? "photo-plate" : ""}`}
                    aria-label={`${plant.name} botanical plate`}
                    style={plantPhotoStyle(artEntry)}
                  >
                    {!hasImage && <span class="plant-visual-icon"></span>}
                  </figure>
                  <div>
                    <span>{sentenceCase(plant.type)}</span>
                    <h3>{plant.name}</h3>
                    <p>{hubPlantSummary(plant, metrics)}</p>
                    <div class="hub-card-tags">
                      {tags.map((tag) => <span>{tag}</span>)}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>

        <section class="hub-section hub-crosslinks" aria-labelledby="hub-crosslinks-title">
          <div class="hub-section-head">
            <div>
              <p class="eyebrow">More planning paths</p>
              <h2 id="hub-crosslinks-title">Related Plant by ZIP guides</h2>
            </div>
            <p>These pages turn the matcher database into crawlable collections without creating thin ZIP-code pages.</p>
          </div>
          <div class="home-hub-grid">
            {hubLinks.map((link) => (
              <a href={link.href}>
                <span>{link.title}</span>
                <strong>{link.description}</strong>
              </a>
            ))}
          </div>
        </section>
      </article>
    </main>
  </body>
</html>
