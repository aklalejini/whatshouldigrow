---
import FaviconTags from "../components/FaviconTags.astro";
import PrimaryNav from "../components/PrimaryNav.astro";
import AnalyticsEvents from "../components/AnalyticsEvents.astro";
import affiliateProducts from "../data/affiliateProducts.json";
import plantMetricSources from "../data/plantMetricSources.json";
import plantMetrics from "../data/plantMetrics.json";
import plantPhotoEntries from "../data/plantPhotos.json";
import plants from "../data/plants.json";
import {
  DEFAULT_SOCIAL_IMAGE,
  SITE_NAME,
  SITE_URL,
  siteUrl
} from "../lib/site";
import {
  HUB_PAGES,
  hubInternalLinks,
  hubMethodCards,
  hubPlantDataPoints,
  hubPlantSummary,
  hubPlantTags,
  hubProductIds,
  hubSourceIntro,
  hubSourceKeyCounts,
  itemListForPlants,
  plantsForHub
} from "../lib/hubData";
import {
  isSourcedValue,
  plantKind,
  plantPrimaryPhotoEntry,
  plantRealPhotoStyle,
  plantUrl,
  sentenceCase
} from "../lib/plantUtils";
import { featuredZoneInternalLinks } from "../lib/zonePageData";
import "../styles/global.css";

export function getStaticPaths() {
  return HUB_PAGES.map((hub) => ({
    params: { hub: hub.slug },
    props: { hub }
  }));
}

const { hub } = Astro.props;
const canonicalUrl = siteUrl(hub.path);
const socialImageUrl = siteUrl(DEFAULT_SOCIAL_IMAGE);
const hubEntries = plantsForHub(hub, plants, plantMetrics);
const featuredEntries = hubEntries.slice(0, 24);
const sourcedYieldCount = hubEntries.filter(({ metrics }) => isSourcedValue(metrics.display?.yieldLbs)).length;
const sourceReadyCount = hubEntries.filter(({ metrics }) => isSourcedValue(metrics.display?.firstOutput)).length;
const hubMethodNotes = hubMethodCards(hub);
const hubSourceRows = hubSourceKeyCounts(hubEntries)
  .map(({ key, count }) => ({ key, count, ...(plantMetricSources[key] ?? {}) }))
  .filter((source) => source.title && source.url);
const hubLinks = hubInternalLinks().filter((link) => link.href !== hub.path);
const zoneGuideLinks = featuredZoneInternalLinks();
const hubResourceProducts = hubProductIds(hub)
  .map((id) => affiliateProducts.find((product) => product.id === id))
  .filter(Boolean);
const isCalendarHub = hub.slug === "planting-calendar";
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: SITE_NAME,
      item: SITE_URL
    },
    {
      "@type": "ListItem",
      position: 2,
      name: hub.shortTitle,
      item: canonicalUrl
    }
  ]
};
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: hub.title,
  description: hub.description,
  url: canonicalUrl,
  numberOfItems: featuredEntries.length,
  itemListElement: itemListForPlants(featuredEntries, SITE_URL)
};
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: hub.title,
  description: hub.description,
  url: canonicalUrl,
  mainEntity: itemListJsonLd
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={hub.description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${hub.title} | ${SITE_NAME}`} />
    <meta property="og:description" content={hub.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${hub.title} | ${SITE_NAME}`} />
    <meta name="twitter:description" content={hub.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,750&family=Inter:wght@400;500;650;750;850&display=swap"
      rel="stylesheet"
    />
    <FaviconTags />
    <title>{hub.title} | {SITE_NAME}</title>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)}></script>
  </head>
  <body>
    <main class="app-shell">
      <PrimaryNav active={isCalendarHub ? "calendar" : "matcher"} />

      <article class="hub-page">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Plant by ZIP</a>
          <span aria-hidden="true">/</span>
          <span>{hub.shortTitle}</span>
        </nav>

        <header class="hub-hero">
          <div>
            <p class="eyebrow">{hub.eyebrow}</p>
            <h1>{hub.title}</h1>
            <p>{hub.summary}</p>
            <div class="hub-actions">
              <a class="plant-page-action is-primary" href={hub.ctaHref}>{hub.ctaLabel}</a>
              <a class="plant-page-action is-secondary" href="/#screener">Open plant screener</a>
            </div>
          </div>
          <dl class="hub-stats" aria-label={`${hub.shortTitle} collection stats`}>
            <div>
              <dt>{hub.filterLabel}</dt>
              <dd>{hubEntries.length}</dd>
            </div>
            <div>
              <dt>Timing data</dt>
              <dd>{sourceReadyCount}</dd>
            </div>
            <div>
              <dt>Sourced yield rows</dt>
              <dd>{sourcedYieldCount}</dd>
            </div>
          </dl>
        </header>

        {hubResourceProducts.length > 0 && (
          <section class="hub-section hub-resource-box" aria-labelledby="hub-resource-title">
            <div class="hub-section-head">
              <div>
                <p class="eyebrow">Useful setup tools</p>
                <h2 id="hub-resource-title">Supplies that fit this planning path</h2>
              </div>
              <p>
                Product links are separate from plant rankings and may earn a commission. Use them as a practical checklist, not a requirement.
              </p>
            </div>
            <div class="hub-resource-grid">
              {hubResourceProducts.map((product) => (
                <article class="hub-resource-card">
                  <div>
                    <span>{product.category} / {product.timing}</span>
                    <h3>{product.name}</h3>
                    <p>{product.use}</p>
                  </div>
                  <a href={product.affiliateUrl} target="_blank" rel="sponsored noopener noreferrer" data-partner-placement="hub_resource_box">
                    View
                  </a>
                </article>
              ))}
            </div>
          </section>
        )}

        <section class="hub-section hub-method-section" aria-labelledby="hub-method-title">
          <div class="hub-section-head">
            <div>
              <p class="eyebrow">How this page is built</p>
              <h2 id="hub-method-title">The filter behind {hub.shortTitle}</h2>
            </div>
            <p>
              The list below is generated from structured plant records, then sorted by sourced metrics,
              site fit, and planning usefulness.
            </p>
          </div>
          <div class="hub-method-grid">
            {hubMethodNotes.map((note) => (
              <article>
                <span>{note.label}</span>
                <p>{note.detail}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="hub-section" aria-labelledby="hub-featured-title">
          <div class="hub-section-head">
            <div>
              <p class="eyebrow">Browse profiles</p>
              <h2 id="hub-featured-title">{featuredEntries.length} useful starting points</h2>
            </div>
            <p>
              Sorted by sourced planning data, site fit, and practical usefulness. Use a ZIP lookup before buying,
              especially near a plant's zone edge.
            </p>
          </div>

          <div class="hub-card-grid">
            {featuredEntries.map(({ plant, metrics }) => {
              const photoEntry = plantPrimaryPhotoEntry(plant, plantPhotoEntries);
              const hasImage = Boolean(photoEntry?.primary?.src);
              const kind = plantKind(plant);
              const tags = hubPlantTags(plant);
              const dataPoints = hubPlantDataPoints(plant, metrics, hub);
              return (
                <a class="hub-plant-card" href={plantUrl(plant)}>
                  <figure
                    class={`plant-visual hub-plant-visual ${kind} ${hasImage ? "real-photo" : ""}`}
                    aria-label={photoEntry?.primary?.alt ?? `${plant.name} plant photo`}
                    style={plantRealPhotoStyle(photoEntry)}
                  >
                    {!hasImage && <span class="plant-visual-icon"></span>}
                  </figure>
                  <div>
                    <span>{sentenceCase(plant.type)}</span>
                    <h3>{plant.name}</h3>
                    <p>{hubPlantSummary(plant, metrics, hub)}</p>
                    <dl class="hub-data-points">
                      {dataPoints.map((point) => (
                        <div>
                          <dt>{point.label}</dt>
                          <dd>{point.value}</dd>
                        </div>
                      ))}
                    </dl>
                    <div class="hub-card-tags">
                      {tags.map((tag) => <span>{tag}</span>)}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>

        {hubSourceRows.length > 0 && (
          <section class="hub-section hub-source-section" aria-labelledby="hub-source-title">
            <div class="hub-section-head">
              <div>
                <p class="eyebrow">Source trail</p>
                <h2 id="hub-source-title">References used by this shortlist</h2>
              </div>
              <p>{hubSourceIntro(hub)}</p>
            </div>
            <div class="hub-source-list">
              {hubSourceRows.map((source) => (
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  <span>{source.count} matching records</span>
                  <strong>{source.title}</strong>
                  <small>{source.note}</small>
                </a>
              ))}
            </div>
            <p class="hub-source-note">
              Individual plant profiles show their own source links and caveats; this page shows the common references behind the current collection.
            </p>
          </section>
        )}

        <section class="hub-section hub-crosslinks" aria-labelledby="hub-crosslinks-title">
          <div class="hub-section-head">
            <div>
              <p class="eyebrow">More planning paths</p>
              <h2 id="hub-crosslinks-title">Related Plant by ZIP guides</h2>
            </div>
            <p>These pages turn the matcher database into crawlable collections without creating thin ZIP-code pages.</p>
          </div>
          <div class="home-hub-grid">
            {hubLinks.map((link) => (
              <a href={link.href}>
                <span>{link.title}</span>
                <strong>{link.description}</strong>
              </a>
            ))}
          </div>
          <div class="home-hub-grid">
            {zoneGuideLinks.map((link) => (
              <a href={link.href}>
                <span>{link.title}</span>
                <strong>{link.description}</strong>
              </a>
            ))}
          </div>
        </section>
      </article>
    </main>
    <AnalyticsEvents pageType="hub" topic={hub.slug} />
  </body>
</html>
