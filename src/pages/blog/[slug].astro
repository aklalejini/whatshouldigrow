---
import FaviconTags from "../../components/FaviconTags.astro";
import PrimaryNav from "../../components/PrimaryNav.astro";
import { getCollection, render } from "astro:content";
import ArticleShare from "../../components/ArticleShare.astro";
import AnalyticsEvents from "../../components/AnalyticsEvents.astro";
import {
  DEFAULT_SOCIAL_IMAGE,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_URL,
  siteUrl
} from "../../lib/site";
import { BLOG_IMAGE_WIDTHS, optimizedImagePath, optimizedSrcset } from "../../lib/imageUtils";
import "../../styles/global.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonicalUrl = siteUrl(`/blog/${post.data.slug}/`);
const socialImageUrl = siteUrl(post.data.heroImage || DEFAULT_SOCIAL_IMAGE);
const shareText = post.data.excerpt || `${post.data.title} from ${SITE_NAME}`;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.excerpt,
  image: socialImageUrl,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: canonicalUrl,
  author: {
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL
  },
  publisher: {
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={post.data.excerpt || SITE_DESCRIPTION} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.excerpt} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    <meta
      property="article:modified_time"
      content={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={post.data.title} />
    <meta name="twitter:description" content={post.data.excerpt} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,750&family=Inter:wght@400;500;650;750;850&display=swap"
      rel="stylesheet"
    />
    <FaviconTags />
    <title>{post.data.title} | {SITE_NAME}</title>
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)}></script>
  </head>
  <body>
    <main class="app-shell">
      <PrimaryNav active="guides" />

      <article class="article-page article-full">
        <p class="eyebrow">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p class="article-dek">{post.data.excerpt}</p>
        <div class="article-full-tags" aria-label="Article tags">
          {post.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
        <ArticleShare
          title={post.data.title}
          text={shareText}
          url={canonicalUrl}
          imageUrl={socialImageUrl}
        />
        <figure class="article-hero-photo">
          <picture>
            <source type="image/avif" srcset={optimizedSrcset(post.data.heroImage, BLOG_IMAGE_WIDTHS, "avif")} sizes="(max-width: 900px) 100vw, 900px" />
            <source type="image/webp" srcset={optimizedSrcset(post.data.heroImage, BLOG_IMAGE_WIDTHS, "webp")} sizes="(max-width: 900px) 100vw, 900px" />
            <img src={optimizedImagePath(post.data.heroImage, 1200, "webp")} alt={post.data.heroAlt} loading="eager" decoding="async" fetchpriority="high" />
          </picture>
        </figure>
        <div class="article-body">
          <Content />
        </div>
        <ArticleShare
          title={post.data.title}
          text={shareText}
          url={canonicalUrl}
          imageUrl={socialImageUrl}
          placement="footer"
        />
      </article>
    </main>
    <AnalyticsEvents pageType="blog_article" topic={post.data.slug} />
  </body>
</html>
