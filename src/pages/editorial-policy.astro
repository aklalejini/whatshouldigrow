---
import PrimaryNav from "../components/PrimaryNav.astro";
import AnalyticsEvents from "../components/AnalyticsEvents.astro";
import { DEFAULT_SOCIAL_IMAGE, SITE_NAME, SITE_URL, siteUrl } from "../lib/site";
import "../styles/global.css";

const canonicalUrl = siteUrl("/editorial-policy/");
const socialImageUrl = siteUrl(DEFAULT_SOCIAL_IMAGE);
const description = "How Plant by ZIP writes, reviews, updates, and limits garden planning guidance.";
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: SITE_URL },
    { "@type": "ListItem", position: 2, name: "Editorial Policy", item: canonicalUrl }
  ]
};
const webPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Editorial Policy",
  description,
  url: canonicalUrl,
  isPartOf: { "@type": "WebSite", name: SITE_NAME, url: SITE_URL }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`Editorial Policy | ${SITE_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`Editorial Policy | ${SITE_NAME}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,750&family=Inter:wght@400;500;650;750;850&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/plantbyzip-icon.png" />
    <link rel="apple-touch-icon" href="/brand/plantbyzip-icon.png" />
    <title>Editorial Policy | {SITE_NAME}</title>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)}></script>
  </head>
  <body>
    <AnalyticsEvents pageType="trust_page" topic="editorial-policy" />
    <main class="app-shell">
      <PrimaryNav />

      <article class="trust-page">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Plant by ZIP</a><span aria-hidden="true">/</span><span>Editorial Policy</span>
        </nav>
        <header class="trust-hero">
          <p class="eyebrow">Editorial policy</p>
          <h1>Garden advice should be useful, sourced, and honest about its limits.</h1>
          <p>
            Plant by ZIP uses structured plant data and plain-language explanations to help gardeners
            compare options. Recommendations are starting points, not a substitute for local extension guidance.
          </p>
        </header>
        <section class="trust-grid" aria-label="Editorial standards">
          <article>
            <h2>How guidance is written</h2>
            <p>Plant pages prioritize hardiness, light, soil, water, timing, spacing, yield ranges, risk notes, and visible source links over decorative copy.</p>
          </article>
          <article>
            <h2>How data is checked</h2>
            <p>Quantitative fields are generated from the site database, then validated for missing records, duplicate IDs, missing photos, stale exports, and oversized assets.</p>
          </article>
          <article>
            <h2>How updates happen</h2>
            <p>Profiles are updated when better sources, photos, plant records, or user-reported corrections are available. Plant profile pages show the latest reviewed date when present.</p>
          </article>
        </section>
        <section class="trust-panel">
          <h2>Use of automation</h2>
          <p>
            Automation may help normalize data, generate code, and flag inconsistencies, but user-facing claims should remain grounded in structured fields, source notes,
            and visible methodology. Uncertain plant data is presented as a planning range rather than a guarantee.
          </p>
        </section>
      </article>
    </main>
  </body>
</html>
