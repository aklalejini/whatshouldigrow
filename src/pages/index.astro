              <span>Column view</span>
              <select id="screener-column-preset">
                <option value="core">Core screener</option>
                <option value="yield">Yield view</option>
                <option value="space">Space efficiency</option>
                <option value="container">Container view</option>
                <option value="risk">Risk view</option>
                <option value="ecology">Native/ecology</option>
                <option value="all">All columns</option>
              </select>
            </label>
            <label class="screener-field" for="screener-saved-screen">
              <span>Saved screen</span>
              <select id="screener-saved-screen">
                <option value="">Choose a screen</option>
              </select>
            </label>
            <label class="screener-field" for="screener-type">
              <span>Type/form</span>
              <select id="screener-type">
                <option value="">Any type/form</option>
              </select>
            </label>
            <label class="screener-field" for="screener-zone">
              <span>Zone fit</span>
              <select id="screener-zone">
                <option value="">Any zone</option>
              </select>
            </label>
            <label class="screener-field" for="screener-horizon">
              <span>Time horizon</span>
              <select id="screener-horizon">
                <option value="">Any horizon</option>
                <option value="quick">Quick harvest</option>
                <option value="seasonal">Seasonal annual</option>
                <option value="fast-perennial">Fast perennial</option>
                <option value="medium">Medium horizon</option>
                <option value="long">Long horizon</option>
              </select>
            </label>
            <label class="screener-field" for="screener-container">
              <span>Container min</span>
              <select id="screener-container">
                <option value="">Any container</option>
                <option value="1">1 gal or less</option>
                <option value="2">2 gal or less</option>
                <option value="5">5 gal or less</option>
                <option value="10">10 gal or less</option>
                <option value="15">15 gal or less</option>
                <option value="25">25 gal or less</option>
              </select>
            </label>
            <label class="screener-field" for="screener-sun">
              <span>Sun</span>
              <select id="screener-sun">
                <option value="">Any sun</option>
                <option value="full">Full</option>
                <option value="partial">Partial</option>
                <option value="shade">Shade</option>
              </select>
            </label>
            <label class="screener-field" for="screener-soil">
              <span>Soil</span>
              <select id="screener-soil">
                <option value="">Any soil</option>
                <option value="clay">Clay</option>
                <option value="loam">Loam</option>
                <option value="sandy">Sandy</option>
              </select>
            </label>
            <label class="screener-field" for="screener-water">
              <span>Water</span>
              <select id="screener-water">
                <option value="">Any water</option>
                <option value="low">Low</option>
                <option value="medium">Medium</option>
                <option value="high">High</option>
              </select>
            </label>
            <label class="screener-field" for="screener-goal">
              <span>Goal</span>
              <select id="screener-goal">
                <option value="">Any goal</option>
              </select>
            </label>
            <label class="screener-field" for="screener-flag">
              <span title="Filter by native flags, low-water needs, or plant pairings.">Attribute</span>
              <select id="screener-flag">
                <option value="">Any attribute</option>
                <option value="native">Native flag</option>
                <option value="low-water">Low water need</option>
                <option value="pairings">Has pairings</option>
                <option value="watchlist">Portfolio</option>
              </select>
            </label>
            <label class="screener-field" for="screener-partner">
              <span>Source</span>
              <select id="screener-partner">
                <option value="">Any source</option>
              </select>
            </label>
            <label class="screener-field" for="screener-confidence">
              <span>Data</span>
              <select id="screener-confidence">
                <option value="">Any data quality</option>
                <option value="medium">Medium+</option>
                <option value="low">Low only</option>
              </select>
            </label>
            <details class="screener-range-panel" open>
              <summary>Numeric filters</summary>
              <div class="screener-range-grid">
                <label class="screener-field" for="screener-min-yield">
                  <span>Min yield lb</span>
                  <input id="screener-min-yield" type="number" inputmode="decimal" min="0" step="1" placeholder="Any" />
                </label>
                <label class="screener-field" for="screener-min-yield-space">
                  <span>Min lb / 100 sq ft</span>
                  <input id="screener-min-yield-space" type="number" inputmode="decimal" min="0" step="1" placeholder="Any" />
                </label>
                <label class="screener-field" for="screener-max-first-output">
                  <span>Max first output yrs</span>
                  <input id="screener-max-first-output" type="number" inputmode="decimal" min="0" step="0.25" placeholder="Any" />
                </label>
                <label class="screener-field" for="screener-max-container">
                  <span>Max container gal</span>
                  <input id="screener-max-container" type="number" inputmode="decimal" min="0" step="1" placeholder="Any" />
                </label>
                <label class="screener-field" for="screener-max-difficulty">
                  <span>Max difficulty</span>
                  <input id="screener-max-difficulty" type="number" inputmode="numeric" min="1" max="5" step="1" placeholder="1-5" />
                </label>
                <label class="screener-field" for="screener-min-reliability">
                  <span>Min reliability</span>
                  <input id="screener-min-reliability" type="number" inputmode="numeric" min="1" max="5" step="1" placeholder="1-5" />
                </label>
                <label class="screener-field" for="screener-max-height">
                  <span>Max height ft</span>
                  <input id="screener-max-height" type="number" inputmode="decimal" min="0" step="1" placeholder="Any" />
                </label>
                <label class="screener-field" for="screener-min-density">
                  <span>Min plants / 100 sq ft</span>
                  <input id="screener-min-density" type="number" inputmode="decimal" min="0" step="1" placeholder="Any" />
                </label>
              </div>
            </details>
          </section>

          <section id="screener-supply-panel" class="screener-supply-panel" aria-labelledby="screener-supply-title" hidden>
            <div>
              <span id="screener-supply-kicker">Matched supplies</span>
              <h2 id="screener-supply-title">Useful supplies for this screen</h2>
              <p class="screener-supply-disclosure">Product links are separate from plant rankings and may earn a commission.</p>
            </div>
            <div id="screener-supply-list" class="screener-supply-list"></div>
          </section>

          <div class="screener-toolbar">
            <p id="screener-summary">Showing all plants.</p>
            <div>
              <button id="screener-group-type" type="button" aria-pressed="false">Group by type</button>
              <label class="screener-source-toggle" for="screener-show-source-links">
                <input id="screener-show-source-links" type="checkbox" />
                <span>Show source links</span>
              </label>
              <a href="/exports/plants.csv">CSV export</a>
              <button id="screener-more" type="button" hidden>Show more</button>
              <button id="screener-reset" type="button">Reset filters</button>
            </div>
          </div>

          <section id="screener-portfolio-panel" class="screener-portfolio-panel" aria-labelledby="screener-portfolio-title">
            <div class="screener-portfolio-head">
              <div>
                <span>Plant portfolio</span>
                <h2 id="screener-portfolio-title">Saved plant portfolio</h2>
                <p id="screener-portfolio-note">Save plants from the table to compare the numbers that matter.</p>
              </div>
              <div class="screener-portfolio-actions">
                <button id="screener-portfolio-filter" type="button">Show portfolio</button>
                <button id="screener-portfolio-open-planner" type="button">Open planner</button>
                <button id="screener-portfolio-compare" type="button">Compare top 5</button>
                <button id="screener-portfolio-export" type="button">Export CSV</button>
                <button id="screener-portfolio-clear" type="button">Clear</button>
              </div>
            </div>
            <div id="screener-portfolio-stats" class="screener-portfolio-stats" aria-label="Portfolio summary"></div>
            <div id="screener-portfolio-table" class="screener-portfolio-table"></div>
          </section>

          <section id="screener-compare-panel" class="screener-compare-panel" aria-labelledby="screener-compare-title" hidden>
            <div class="screener-compare-head">
              <div>
                <span>Compare basket</span>
                <h2 id="screener-compare-title">Select up to 5 plants</h2>
              </div>
              <button id="screener-clear-compare" type="button">Clear compare</button>
            </div>
            <p id="screener-compare-status">Choose rows from the table to compare core metrics side by side.</p>
            <div id="screener-compare-table" class="screener-compare-table"></div>
          </section>

          <div class="screener-table-wrap" role="region" aria-label="Plant screener results" tabindex="0">
            <table class="screener-table">
              <thead>
                <tr>
                  <th scope="col" aria-sort="ascending" data-screener-col="name"><button type="button" data-screener-sort="name">Name <span class="sort-indicator">&uarr; A-Z</span></button></th>
                  <th scope="col" data-screener-col="type"><button type="button" data-screener-sort="type">Type/form <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="zone"><button type="button" data-screener-sort="zone">Zone range <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="firstOutput"><button type="button" data-screener-sort="firstOutput">First output <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="spacing"><button type="button" data-screener-sort="spacing">Spacing <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="plantingDepth"><button type="button" data-screener-sort="plantingDepth">Planting depth <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="container"><button type="button" data-screener-sort="container">Container min <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="yield"><button type="button" data-screener-sort="output">Yield (lbs) <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="yieldPerSpace"><button type="button" data-screener-sort="yieldPerSpace" title="Estimated annual pound return multiplied by plants per 100 square feet.">Yield / 100 sq ft <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="score"><button type="button" data-screener-sort="score" title="Difficulty- and reliability-adjusted yield score.">Scores <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="difficulty"><button type="button" data-screener-sort="difficulty">Difficulty <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="reliability"><button type="button" data-screener-sort="reliability">Reliability <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="data"><button type="button" data-screener-sort="dataQuality" title="Metric confidence, source count, method, and review date.">Data <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="sun"><button type="button" data-screener-sort="sun">Sun <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="soil"><button type="button" data-screener-sort="soil">Soil <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="water"><button type="button" data-screener-sort="water">Water <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="goals"><button type="button" data-screener-sort="goals">Goals <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="harvest"><button type="button" data-screener-sort="harvest">Harvest/season <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="traits"><button type="button" data-screener-sort="traits">Traits <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="native"><button type="button" data-screener-sort="native" title="Derived from current plant notes and goals, not a full native-range database.">Native flag <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="lowWater"><button type="button" data-screener-sort="lowMaintenance" title="Plants with low water needs.">Low water <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="pairings"><button type="button" data-screener-sort="pairings" title="Companion or placement pairing rules connected to this plant.">Pairings <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="screening"><button type="button" data-screener-sort="screening" title="Planning cues for pH, pollination, support, pests, chill, heat, storage, and regional warnings.">Screening cues <span class="sort-indicator"></span></button></th>
                  <th scope="col" data-screener-col="source"><button type="button" data-screener-sort="partner">Source <span class="sort-indicator"></span></button></th>
                  <th class="screener-action-head" scope="col" data-screener-col="profile">Profile</th>
                </tr>
              </thead>
              <tbody id="screener-body"></tbody>
            </table>
          </div>
          <p id="screener-empty" class="screener-empty" hidden>No plants match those filters.</p>
        </div>
      </section>

      <section
        id="garden-planner-view"
        class="view-panel garden-planner-view"
        role="tabpanel"
        data-view-panel="garden-planner"
        aria-labelledby="garden-planner-title"
        hidden
      >
        <div class="garden-planner-shell">
          <header class="garden-planner-header">
            <div>
              <p class="eyebrow">Saved garden workspace</p>
              <h1 id="garden-planner-title">Garden planner</h1>
              <p>
                A working shortlist from plants saved in the Screener, with quantities,
                yield estimates, space, risks, and supply matches in one place.
              </p>
            </div>
            <div id="garden-planner-stats" class="garden-planner-stats" aria-label="Garden planner summary"></div>
          </header>

          <div class="garden-planner-actions" aria-label="Garden planner actions">
            <button id="garden-planner-compare" type="button">Compare saved plants</button>
            <button id="garden-planner-export" type="button">Export CSV</button>
            <button id="garden-planner-clear" type="button">Clear garden</button>
          </div>

          <section
            id="garden-planner-add"
            class="garden-planner-add"
            aria-labelledby="garden-planner-add-title"
          >
            <div class="garden-planner-section-head">
              <div>
                <p class="eyebrow">Add plants</p>
                <h2 id="garden-planner-add-title">Quick add plants</h2>
              </div>
              <p>Search by plant name, type, trait, or crop note.</p>
            </div>
            <div class="garden-planner-add-tools">
              <label>
                <span>Quick search</span>
                <input
                  id="garden-planner-search"
                  type="search"
                  placeholder="Search tomato, blueberry, basil..."
                  autocomplete="off"
                />
              </label>
              <button id="garden-planner-open-screener" type="button">Full plant listing</button>
            </div>
            <div
              id="garden-planner-search-results"
              class="garden-planner-search-results"
              aria-live="polite"
            ></div>
          </section>

          <section
            id="garden-planner-settings"
            class="garden-planner-settings"
            aria-labelledby="garden-planner-settings-title"
          >
            <div class="garden-planner-section-head">
              <div>
                <p class="eyebrow">Garden settings</p>
                <h2 id="garden-planner-settings-title">Site and bed budget</h2>
              </div>
              <p>Saved on this device and used to flag fit, timing, and space pressure.</p>
            </div>
            <form id="garden-planner-settings-form" class="garden-planner-settings-grid">
              <label>
                <span>ZIP</span>
                <input
                  id="garden-planner-zip"
                  name="zip"
                  type="text"
                  inputmode="numeric"
                  pattern="[0-9]{5}"
                  maxlength="5"
                  placeholder="30301"
                />
              </label>
              <label>
                <span>USDA zone</span>
                <select id="garden-planner-zone" name="zone"></select>
              </label>
              <label>
                <span>Bed length</span>
                <input
                  id="garden-planner-bed-length"
                  name="bedLength"
                  type="number"
                  min="1"
                  max="200"
                  step="0.5"
                />
              </label>
              <label>
                <span>Bed width</span>
                <input
                  id="garden-planner-bed-width"
                  name="bedWidth"
                  type="number"
                  min="1"
                  max="200"
                  step="0.5"
                />
              </label>
              <label>
                <span>Bed count</span>
                <input
                  id="garden-planner-bed-count"
                  name="bedCount"
                  type="number"
                  min="1"
                  max="50"
                  step="1"
                />
              </label>
              <label>
                <span>Sun</span>
                <select id="garden-planner-sun" name="sun">
                  <option value="full">Full sun</option>
                  <option value="partial">Part sun</option>
                  <option value="shade">Shade</option>
                </select>
              </label>
              <label>
                <span>Soil</span>
                <select id="garden-planner-soil" name="soil">
                  <option value="loam">Loam</option>
                  <option value="sandy">Sandy</option>
                  <option value="clay">Clay</option>
                </select>
              </label>
              <label>
                <span>Water</span>
                <select id="garden-planner-water" name="water">
                  <option value="low">Low</option>
                  <option value="medium">Medium</option>
                  <option value="high">High</option>
                </select>
              </label>
              <label>
                <span>Format</span>
                <select id="garden-planner-mode" name="mode">
                  <option value="in-ground">In-ground beds</option>
                  <option value="containers">Containers</option>
                  <option value="mixed">Mixed garden</option>
                </select>
              </label>
              <button type="submit">Lookup ZIP</button>
            </form>
            <p id="garden-planner-settings-status" class="garden-planner-settings-status"></p>
          </section>

          <section
            id="garden-planner-warnings"
            class="garden-planner-warnings"
            aria-labelledby="garden-planner-warnings-title"
          ></section>

          <section
            id="garden-planner-space"
            class="garden-planner-space"
            aria-labelledby="garden-planner-space-title"
          ></section>

          <section
            id="garden-planner-timeline"
            class="garden-planner-timeline"
            aria-labelledby="garden-planner-timeline-title"
          ></section>

          <section
            id="garden-planner-compare-panel"
            class="garden-planner-compare-panel"
            aria-labelledby="garden-planner-compare-title"
            hidden
          ></section>

          <section
            id="garden-planner-table"
            class="garden-planner-table"
            aria-labelledby="garden-planner-table-title"
          ></section>

          <section
            id="garden-planner-supplies"
            class="garden-planner-supplies"
            aria-labelledby="garden-planner-supplies-title"
          ></section>
        </div>
      </section>

      <section
        id="blog-view"
        class="view-panel blog-view"
        role="tabpanel"
        data-view-panel="blog"
        aria-labelledby="blog-title"
        hidden
      >
        <div class="blog-shell">
          <header class="blog-hero">
            <div>
              <p class="eyebrow">Field notes</p>
              <h1 id="blog-title">Guides</h1>
              <p>
                Practical growing notes for matching plants to real yards, real weather,
                and the space you actually have.
              </p>
            </div>
            <figure class="blog-hero-photo">
              <picture>
                <source type="image/avif" srcset={optimizedSrcset(blogArticles[0].heroImage, BLOG_IMAGE_WIDTHS, "avif")} sizes="(max-width: 760px) 100vw, 520px" />
                <source type="image/webp" srcset={optimizedSrcset(blogArticles[0].heroImage, BLOG_IMAGE_WIDTHS, "webp")} sizes="(max-width: 760px) 100vw, 520px" />
                <img src={optimizedImagePath(blogArticles[0].heroImage, 1200, "webp")} alt={blogArticles[0].heroAlt} loading="eager" decoding="async" fetchpriority="high" />
              </picture>
            </figure>
            <div class="blog-search">
              <label for="article-search">Search articles</label>
              <input id="article-search" type="search" placeholder="Search by topic, tag, or text" />
            </div>
          </header>

          <div id="article-list" class="article-list">
            {blogArticles.map((article) => (
              <a class="article-card" href={article.url} data-article-slug={article.slug}>
                <span class="article-category">{article.category}</span>
                <h2>{article.title}</h2>
                <p>{article.excerpt}</p>
                <span class="article-open">Read article</span>
                <span class="article-tags" aria-label="Article tags">
                  {article.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
                </span>
              </a>
            ))}
          </div>
          <p id="blog-empty" class="blog-empty" hidden>No articles match that search.</p>
        </div>
      </section>
    </main>

    <AnalyticsEvents pageType="home" />
    <script type="module" src="/js/plantbyzip-home.js"></script>
  </body>
</html>
