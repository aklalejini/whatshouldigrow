---
import plants from "../data/plants.json";
import partners from "../data/affiliatePartners.json";
import "../styles/global.css";

const plantCount = Array.isArray(plants) ? plants.length : 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Enter a ZIP code and growing conditions to get ranked plant recommendations with nursery links."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,750&family=Inter:wght@400;500;650;750;850&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>What Should I Grow | ZIP-Based Plant Matcher</title>
  </head>
  <body>
    <main class="app-shell">
      <section class="workspace" aria-labelledby="app-title">
        <div class="intro-panel">
          <div class="brand-lockup" aria-label="What Should I Grow">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>What Should I Grow</span>
          </div>
          <h1 id="app-title">What should I grow here?</h1>
          <p>
            Enter your ZIP code and a few garden conditions. Get a ranked field-guide of edible,
            pollinator, and ornamental plants that are actually worth considering.
          </p>
          <figure class="hero-plate hero-gallery" aria-hidden="true">
            <span class="hero-frame" style="--hero-image: url('/plant-art/fig.webp'); --i: 0"></span>
            <span class="hero-frame" style="--hero-image: url('/plant-art/blueberry.webp'); --i: 1"></span>
            <span class="hero-frame" style="--hero-image: url('/plant-art/persimmon.webp'); --i: 2"></span>
            <span class="hero-frame" style="--hero-image: url('/plant-art/plum.webp'); --i: 3"></span>
            <span class="hero-frame" style="--hero-image: url('/plant-art/elderberry.webp'); --i: 4"></span>
            <span class="hero-specimen hero-specimen-a"></span>
            <span class="hero-specimen hero-specimen-b"></span>
            <span class="hero-specimen hero-specimen-c"></span>
          </figure>
        </div>

        <form class="matcher-panel" id="matcher-form">
          <div class="form-heading">
            <p class="eyebrow">Plot conditions</p>
            <h2>Start with your place.</h2>
          </div>
          <div class="zip-row">
            <div>
              <label for="zip">ZIP code</label>
              <p>Hardiness zone anchors the ranking.</p>
            </div>
            <input
              id="zip"
              name="zip"
              inputmode="numeric"
              pattern="[0-9]{5}"
              maxlength="5"
              autocomplete="postal-code"
              placeholder="75001"
              required
            />
            <div id="zone-preview" class="zone-preview" hidden></div>
          </div>

          <fieldset>
            <legend>Sun exposure</legend>
            <div class="segmented">
              <label>
                <input type="radio" name="sun" value="full" checked />
                <span class="option-card"><span class="option-label">Full</span><span class="option-help">6+ hours</span></span>
              </label>
              <label>
                <input type="radio" name="sun" value="partial" />
                <span class="option-card"><span class="option-label">Partial</span><span class="option-help">3-6 hours</span></span>
              </label>
              <label>
                <input type="radio" name="sun" value="shade" />
                <span class="option-card"><span class="option-label">Shade</span><span class="option-help">Mostly indirect</span></span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Soil type</legend>
            <div class="segmented">
              <label>
                <input type="radio" name="soil" value="clay" />
                <span class="option-card"><span class="option-label">Clay</span><span class="option-help">Sticky, holds water</span></span>
              </label>
              <label>
                <input type="radio" name="soil" value="loam" checked />
                <span class="option-card"><span class="option-label">Loam</span><span class="option-help">Crumbly, balanced</span></span>
              </label>
              <label>
                <input type="radio" name="soil" value="sandy" />
                <span class="option-card"><span class="option-label">Sandy</span><span class="option-help">Gritty, drains fast</span></span>
              </label>
              <label>
                <input type="radio" name="soil" value="not-sure" />
                <span class="option-card"><span class="option-label">Not sure</span><span class="option-help">Uses loam</span></span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Water availability</legend>
            <div class="segmented">
              <label>
                <input type="radio" name="water" value="low" />
                <span class="option-card"><span class="option-label">Low</span><span class="option-help">Dry spells</span></span>
              </label>
              <label>
                <input type="radio" name="water" value="medium" checked />
                <span class="option-card"><span class="option-label">Medium</span><span class="option-help">Normal watering</span></span>
              </label>
              <label>
                <input type="radio" name="water" value="high" />
                <span class="option-card"><span class="option-label">High</span><span class="option-help">Moist beds</span></span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Goal</legend>
            <div class="segmented goal-grid">
              <label>
                <input type="radio" name="goal" value="fruit" checked />
                <span class="option-card"><span class="option-label">Fruit</span><span class="option-help">Trees, vines, berries</span></span>
              </label>
              <label>
                <input type="radio" name="goal" value="vegetables" />
                <span class="option-card"><span class="option-label">Vegetables</span><span class="option-help">Kitchen crops</span></span>
              </label>
              <label>
                <input type="radio" name="goal" value="pollinator" />
                <span class="option-card"><span class="option-label">Pollinator</span><span class="option-help">Flowers and habitat</span></span>
              </label>
              <label>
                <input type="radio" name="goal" value="ornamental" />
                <span class="option-card"><span class="option-label">Ornamental</span><span class="option-help">Looks good first</span></span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Plant form</legend>
            <div class="segmented form-grid">
              <label>
                <input type="radio" name="form" value="any" checked />
                <span class="option-card"><span class="option-label">Any</span><span class="option-help">Best fit first</span></span>
              </label>
              <label>
                <input type="radio" name="form" value="tree" />
                <span class="option-card"><span class="option-label">Tree</span><span class="option-help">Orchard anchors</span></span>
              </label>
              <label>
                <input type="radio" name="form" value="shrub" />
                <span class="option-card"><span class="option-label">Shrub</span><span class="option-help">Hedges, berries</span></span>
              </label>
              <label>
                <input type="radio" name="form" value="vine" />
                <span class="option-card"><span class="option-label">Vine</span><span class="option-help">Needs support</span></span>
              </label>
              <label>
                <input type="radio" name="form" value="vegetable" />
                <span class="option-card"><span class="option-label">Vegetable</span><span class="option-help">Beds and pots</span></span>
              </label>
              <label>
                <input type="radio" name="form" value="flower-herb" />
                <span class="option-card"><span class="option-label">Flower/herb</span><span class="option-help">Useful color</span></span>
              </label>
            </div>
          </fieldset>

          <button class="match-button" type="submit">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M11 20a9 9 0 1 1 7.03-3.38l3.17 3.17-1.41 1.41-3.17-3.17A8.96 8.96 0 0 1 11 20Zm0-2a7 7 0 1 0 0-14 7 7 0 0 0 0 14Z"></path>
            </svg>
            Find plants
          </button>
        </form>
      </section>

      <section class="results-band" aria-live="polite">
        <div class="results-head">
          <div>
            <p class="eyebrow">Ranked picks</p>
            <h2 id="results-title">Enter a ZIP code to start.</h2>
          </div>
          <p id="zone-note">Not sure about soil defaults to loam. Recommendations are practical starting points, not local extension advice.</p>
        </div>
        <div id="status" class="status"></div>
        <ol id="results" class="results-grid"></ol>
        <div class="results-actions">
          <button id="save-list" class="save-list-button" type="button" hidden>Save this list</button>
          <button id="see-more" class="see-more-button" type="button" hidden>See more results</button>
        </div>
      </section>
    </main>

    <script is:inline type="application/json" id="plant-data" set:html={JSON.stringify(plants)}></script>
    <script is:inline type="application/json" id="partner-data" set:html={JSON.stringify(partners)}></script>
    <script is:inline>
      const plants = JSON.parse(document.getElementById("plant-data").textContent);
      const partners = JSON.parse(document.getElementById("partner-data").textContent);
      const form = document.getElementById("matcher-form");
      const statusEl = document.getElementById("status");
      const titleEl = document.getElementById("results-title");
      const zoneNoteEl = document.getElementById("zone-note");
      const resultsEl = document.getElementById("results");
      const seeMoreEl = document.getElementById("see-more");
      const saveListEl = document.getElementById("save-list");
      const zipEl = document.getElementById("zip");
      const zonePreviewEl = document.getElementById("zone-preview");
      let currentRanked = [];
      let currentInputs = null;
      let visibleCount = 12;
      const zoneCache = new Map();
      let zoneLookupTimer = null;

      const waterRank = { low: 1, medium: 2, high: 3 };
      const waterCopy = {
        low: "it can coast through dry spells once established",
        medium: "normal garden watering is plenty",
        high: "it appreciates steady moisture"
      };

      function zoneToNumber(zone) {
        const match = String(zone).trim().toLowerCase().match(/^(\d{1,2})([ab])$/);
        if (!match) return Number.NaN;
        return Number(match[1]) + (match[2] === "b" ? 0.5 : 0);
      }

      async function lookupZone(zip) {
        if (zoneCache.has(zip)) return zoneCache.get(zip);
        const response = await fetch(`https://phzmapi.org/${zip}.json`);
        if (!response.ok) throw new Error("Zone lookup failed");
        const data = await response.json();
        if (!data.zone) throw new Error("Zone missing from lookup");
        zoneCache.set(zip, data);
        return data;
      }

      function buildAffiliateUrl(plant) {
        const partner = partners[plant.partner] ?? partners.amazon;
        const searchUrl = partner.searchUrl.replace("{query}", encodeURIComponent(plant.query ?? plant.name));
        const glue = searchUrl.includes("?") ? "&" : "?";
        return `${searchUrl}${glue}${partner.affiliateParam}`;
      }

      function clamp(value, min, max) {
        return Math.min(max, Math.max(min, value));
      }

      function formatList(values) {
        return values.map((value) => value.replace("-", " ")).join(", ");
      }

      function sentenceCase(text) {
        return text ? text.charAt(0).toUpperCase() + text.slice(1) : "";
      }

      function plantKind(plant) {
        const type = plant.type.toLowerCase();
        if (type.includes("flower") || type.includes("herb") || type.includes("grass")) return "bloom";
        if (type.includes("vegetable")) return "vegetable";
        if (type.includes("vine")) return "vine";
        if (type.includes("shrub") || type.includes("cane")) return "shrub";
        return "fruit";
      }

      function plantArt(plant) {
        const identity = `${plant.id} ${plant.name} ${plant.query ?? ""}`.toLowerCase();
        if (identity.includes("blackberry")) return "blackberry";
        if (identity.includes("raspberry")) return "raspberry";
        if (identity.includes("fig")) return "fig";
        if (identity.includes("aronia") || identity.includes("chokeberry")) return "aronia";
        if (identity.includes("blueberry")) return "blueberry";
        if (identity.includes("elderberry")) return "elderberry";
        if (identity.includes("persimmon")) return "persimmon";
        if (identity.includes("plum")) return "plum";
        if (identity.includes("serviceberry")) return "serviceberry";
        if (
          identity.includes("bush cherry") ||
          identity.includes("carmine-jewel-cherry") ||
          identity.includes("romeo-bush-cherry") ||
          identity.includes("nanking-cherry")
        ) return "bushcherry";
        return genericArt(plant);
      }

      function genericArt(plant) {
        const type = plant.type.toLowerCase();
        if (type.includes("flower") || type.includes("herb") || type.includes("grass") || type.includes("ornamental")) return "generic-flower-herb";
        if (type.includes("vegetable")) return "generic-vegetable";
        if (type.includes("vine")) return "generic-vine";
        if (type.includes("tree")) return "generic-tree";
        return "generic-fruit";
      }

      function plantImage(plant) {
        const art = plantArt(plant);
        const images = {
          aronia: "/plant-art/aronia.webp",
          blackberry: "/plant-art/blackberry.webp",
          blueberry: "/plant-art/blueberry.webp",
          bushcherry: "/plant-art/bush-cherry.webp",
          elderberry: "/plant-art/elderberry.webp",
          fig: "/plant-art/fig.webp",
          "generic-flower-herb": "/plant-art/generic-flower-herb.webp",
          "generic-fruit": "/plant-art/generic-fruit.webp",
          "generic-tree": "/plant-art/generic-tree.webp",
          "generic-vegetable": "/plant-art/generic-vegetable.webp",
          "generic-vine": "/plant-art/generic-vine.webp",
          persimmon: "/plant-art/persimmon.webp",
          plum: "/plant-art/plum.webp",
          raspberry: "/plant-art/raspberry.webp",
          serviceberry: "/plant-art/serviceberry.webp",
        };
        return images[art] ?? "";
      }

      function scoreBreakdown(plant, inputs) {
        const userZone = zoneToNumber(inputs.zone);
        const minZone = zoneToNumber(plant.zones[0]);
        const maxZone = zoneToNumber(plant.zones[1]);
        const details = [];
        let zoneScore = -120;
        let zoneFit = 0;
        let zoneLabel = "outside range";

        if (userZone >= minZone && userZone <= maxZone) {
          zoneScore = 80;
          zoneFit = 100;
          zoneLabel = "in range";
        } else {
          const distance = userZone < minZone ? minZone - userZone : userZone - maxZone;
          zoneScore = distance <= 0.5 ? 25 : -120;
          zoneFit = distance <= 0.5 ? 42 : 0;
          zoneLabel = distance <= 0.5 ? "borderline" : "poor fit";
        }
        details.push({ label: "Hardiness", value: zoneFit, score: zoneScore, note: `${plant.zones[0]}-${plant.zones[1]} (${zoneLabel})` });

        const goalFit = plant.goals.includes(inputs.goal);
        details.push({
          label: "Goal",
          value: goalFit ? 100 : 0,
          score: goalFit ? 34 : 0,
          note: goalFit ? `matches ${inputs.goal}` : `better for ${formatList(plant.goals)}`
        });

        let sunScore = -18;
        let sunFit = 0;
        let sunNote = `wants ${formatList(plant.sun)}`;
        if (plant.sun.includes(inputs.sun)) {
          sunScore = 22;
          sunFit = 100;
          sunNote = `takes ${inputs.sun}`;
        } else if (inputs.sun === "partial" && plant.sun.includes("full")) {
          sunScore = 4;
          sunFit = 45;
          sunNote = "borderline in partial sun";
        }
        details.push({ label: "Sun", value: sunFit, score: sunScore, note: sunNote });

        let soilScore = -14;
        let soilFit = 0;
        let soilNote = `prefers ${formatList(plant.soils)}`;
        if (plant.soils.includes(inputs.soil)) {
          soilScore = 16;
          soilFit = 100;
          soilNote = `handles ${inputs.soil}`;
        } else if (inputs.soil === "loam") {
          soilScore = 4;
          soilFit = 55;
          soilNote = "loam is a workable default";
        }
        details.push({ label: "Soil", value: soilFit, score: soilScore, note: soilNote });

        const selectedWater = waterRank[inputs.water];
        const plantWater = waterRank[plant.water];
        let waterScore = -(plantWater - selectedWater) * 18;
        let waterFit = 30;
        let waterNote = `${plant.water} water need`;
        if (plantWater === selectedWater) {
          waterScore = 16;
          waterFit = 100;
          waterNote = `matches ${inputs.water} water`;
        } else if (plantWater < selectedWater) {
          waterScore = 9;
          waterFit = 78;
          waterNote = "will not mind extra water";
        }
        details.push({ label: "Water", value: clamp(waterFit, 0, 100), score: waterScore, note: waterNote });

        let bonus = 0;
        if (plant.type.includes("annual") && inputs.goal === "vegetables") bonus += 8;
        if (plant.type.includes("fruit") && inputs.goal === "fruit") bonus += 6;
        if (plant.type.includes("perennial") && inputs.goal === "pollinator") bonus += 5;
        if (bonus > 0) details.push({ label: "Use case", value: 100, score: bonus, note: "extra practical fit" });

        const score = details.reduce((sum, detail) => sum + detail.score, 0);
        return { score, details };
      }

      function scorePlant(plant, inputs) {
        return scoreBreakdown(plant, inputs).score;
      }

      function rankingScore(plant, inputs) {
        const base = scorePlant(plant, inputs);
        const userZone = zoneToNumber(inputs.zone);
        const minZone = zoneToNumber(plant.zones[0]);
        const maxZone = zoneToNumber(plant.zones[1]);
        const edgeMargin = userZone >= minZone && userZone <= maxZone ? Math.min(userZone - minZone, maxZone - userZone) : -4;
        const zoneCenter = (minZone + maxZone) / 2;
        const centerPenalty = Math.abs(userZone - zoneCenter) / 20;
        const conditionFit =
          (plant.sun.includes(inputs.sun) ? 0.28 : 0) +
          (plant.soils.includes(inputs.soil) ? 0.2 : 0) +
          (plant.water === inputs.water ? 0.2 : plant.water === "low" && inputs.water !== "low" ? 0.08 : 0);
        const goalSpecificity = plant.goals[0] === inputs.goal ? 0.18 : plant.goals.includes(inputs.goal) ? 0.1 : 0;
        const formSpecificity = inputs.form !== "any" && matchesPlantForm(plant, inputs.form) ? 0.12 : 0;
        return base + clamp(edgeMargin, -4, 4) * 0.7 - centerPenalty + conditionFit + goalSpecificity + formSpecificity;
      }

      function overallFit(score) {
        const percent = clamp(Math.round((score / 180) * 100), 0, 100);
        let label = "Weak";
        let tone = "weak";
        if (percent >= 92) {
          label = "Excellent";
          tone = "excellent";
        } else if (percent >= 82) {
          label = "Strong";
          tone = "strong";
        } else if (percent >= 68) {
          label = "Good";
          tone = "good";
        } else if (percent >= 52) {
          label = "Workable";
          tone = "workable";
        }
        return { percent, label, tone };
      }

      function matchesPlantForm(plant, selectedForm) {
        if (selectedForm === "any") return true;
        const type = plant.type.toLowerCase();
        if (selectedForm === "tree") return type.includes("tree") || type === "citrus";
        if (selectedForm === "shrub") return type.includes("shrub") || type.includes("cane");
        if (selectedForm === "vine") return type.includes("vine");
        if (selectedForm === "vegetable") return type.includes("vegetable");
        if (selectedForm === "flower-herb") return type.includes("flower") || type.includes("herb") || type.includes("grass");
        return true;
      }

      function explainPlant(plant, inputs) {
        const soilLine = plant.soils.includes(inputs.soil)
          ? `${sentenceCase(inputs.soil)} soil is fine`
          : `Best in ${plant.soils.join(" or ")} soil`;
        const sunLine = plant.sun.includes(inputs.sun)
          ? inputs.sun === "full" ? "give it sun" : `${inputs.sun} sun works`
          : `It would rather have ${formatList(plant.sun)} sun`;
        return `Easy in zone ${inputs.zone}. ${soilLine}; ${waterCopy[plant.water]}; ${sunLine}. ${sentenceCase(plant.harvest)}.`;
      }

      function whyThisWon(plant, inputs) {
        const reasons = [];
        if (plant.goals.includes(inputs.goal)) reasons.push(`it matches your ${inputs.goal} goal`);
        if (plant.sun.includes(inputs.sun)) reasons.push(`${inputs.sun} sun suits it`);
        if (plant.soils.includes(inputs.soil)) reasons.push(`${inputs.soil} soil works`);
        if (plant.water === inputs.water) reasons.push(`${inputs.water} watering is right`);
        return reasons.length
          ? `Why this won: ${reasons.slice(0, 3).join(", ")}.`
          : "Why this won: it has the strongest zone and condition fit in this search.";
      }

      function renderFitRows(details) {
        return details
          .map((detail) => {
            const fitClass = detail.value >= 80 ? "good" : detail.value >= 40 ? "okay" : "weak";
            const fitText = detail.value >= 80 ? "strong fit" : detail.value >= 40 ? "workable" : "weak fit";
            return `
              <div class="fit-row ${fitClass}">
                <div class="fit-copy">
                  <span>${detail.label}</span>
                  <strong>${detail.note}</strong>
                </div>
                <div class="fit-meter" aria-hidden="true">
                  <span class="fit-line"></span>
                  <span class="fit-dot" style="left: ${detail.value}%"></span>
                </div>
                <em>${fitText}</em>
              </div>
            `;
          })
          .join("");
      }

      function renderZoneRange(plant, inputs) {
        const min = 2;
        const max = 11.5;
        const zoneStart = clamp(((zoneToNumber(plant.zones[0]) - min) / (max - min)) * 100, 0, 100);
        const zoneEnd = clamp(((zoneToNumber(plant.zones[1]) - min) / (max - min)) * 100, 0, 100);
        const userPoint = clamp(((zoneToNumber(inputs.zone) - min) / (max - min)) * 100, 0, 100);
        return `
          <div class="zone-range">
            <div class="range-track" aria-hidden="true">
              <span class="range-fit" style="left: ${zoneStart}%; width: ${Math.max(2, zoneEnd - zoneStart)}%"></span>
              <span class="range-pin" style="left: ${userPoint}%"></span>
            </div>
            <div class="range-labels">
              <span>Zone ${plant.zones[0]}</span>
              <strong>Your ${inputs.zone}</strong>
              <span>Zone ${plant.zones[1]}</span>
            </div>
          </div>
        `;
      }

      function createResultItem(entry, index, inputs) {
        const { plant, score } = entry;
        const item = document.createElement("li");
        const kind = plantKind(plant);
        const art = plantArt(plant);
        const image = plantImage(plant);
        const photoStyle = image ? ` style="--plant-photo: url('${image}')"` : "";
        const detailArt = image
          ? `<figure class="detail-art ${art}" role="img" aria-label="${plant.name} botanical plate"${photoStyle}>
              <span>${plant.name}</span>
            </figure>`
          : "";
        item.className = `result-card ${index === 0 ? "top-card" : ""} ${kind}-card ${art}-art`;

        const partner = partners[plant.partner] ?? partners.amazon;
        const breakdown = scoreBreakdown(plant, inputs);
        const fit = overallFit(score);
        item.innerHTML = `
          <figure class="plant-visual ${kind} ${art} ${image ? "photo-plate" : ""}" aria-hidden="true"${photoStyle}>
            <span class="rank">${index + 1}</span>
            ${image ? "" : `<span class="plant-visual-icon"></span>`}
          </figure>
          <div class="result-copy">
            <div class="result-title">
              <h3>${plant.name}</h3>
              <span>${plant.type}</span>
            </div>
            <div class="overall-fit ${fit.tone}" style="--fit: ${fit.percent}%" aria-label="Overall fit ${fit.percent} percent, ${fit.label}">
              <div class="fit-ring" aria-hidden="true"><span>${fit.percent}</span></div>
              <div>
                <span>Overall fit</span>
                <strong>${fit.label}</strong>
              </div>
            </div>
            ${index === 0 ? `<p class="winner-note">${whyThisWon(plant, inputs)}</p>` : ""}
            <p>${explainPlant(plant, inputs)}</p>
            <div class="trait-row">
              ${plant.traits.slice(0, 2).map((trait) => `<span>${trait}</span>`).join("")}
            </div>
          </div>
          <details class="plant-details ${image ? "has-art" : ""}">
            <summary>
              <span>More data</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7.4 8.6 12 13.2l4.6-4.6L18 10l-6 6-6-6 1.4-1.4Z"></path>
              </svg>
            </summary>
            <div class="details-grid">
              ${detailArt}
              <div class="detail-panel">
                <h4>Fit breakdown</h4>
                <div class="fit-chart">
                  ${renderFitRows(breakdown.details)}
                </div>
              </div>
              <div class="detail-panel">
                <h4>Plant data</h4>
                ${renderZoneRange(plant, inputs)}
                <dl class="plant-stats">
                  <div><dt>Sun</dt><dd>${formatList(plant.sun)}</dd></div>
                  <div><dt>Soil</dt><dd>${formatList(plant.soils)}</dd></div>
                  <div><dt>Water</dt><dd>${plant.water}</dd></div>
                  <div><dt>Use</dt><dd>${formatList(plant.goals)}</dd></div>
                </dl>
              </div>
              <p class="grow-note">${plant.notes}</p>
            </div>
          </details>
          <div class="card-actions">
            <a class="buy-link" href="${buildAffiliateUrl(plant)}" target="_blank" rel="nofollow sponsored noopener">
              ${partner.name}
            </a>
          </div>
        `;
        return item;
      }

      function renderVisibleResults() {
        const visible = currentRanked.slice(0, visibleCount);
        resultsEl.replaceChildren(...visible.map((entry, index) => createResultItem(entry, index, currentInputs)));
        if (currentRanked.length > visibleCount) {
          seeMoreEl.hidden = false;
          seeMoreEl.textContent = `See more results (${currentRanked.length - visibleCount} left)`;
        } else {
          seeMoreEl.hidden = true;
        }
      }

      function renderResults(zoneData, inputs) {
        const candidates = plants.filter((plant) => matchesPlantForm(plant, inputs.form));
        const ranked = candidates
          .map((plant) => ({ plant, score: scorePlant(plant, inputs), rankScore: rankingScore(plant, inputs) }))
          .sort((a, b) => b.rankScore - a.rankScore || b.score - a.score || a.plant.name.localeCompare(b.plant.name));

        const formLabel = inputs.form === "any" ? "" : ` ${inputs.form.replace("-", " and ")}`;
        titleEl.textContent = `Best${formLabel} matches for zone ${inputs.zone}.`;
        zoneNoteEl.textContent = zoneData.temperature_range
          ? `USDA average annual extreme minimum: ${zoneData.temperature_range} F. Zone lookup returned coordinates near ${zoneData.coordinates.lat}, ${zoneData.coordinates.lon}.`
          : "Zone lookup succeeded. Local microclimates, chill hours, pests, and drainage still matter.";
        if (ranked.length === 0) {
          statusEl.textContent = "No plants matched that form filter. Try Any or loosen one growing condition.";
          resultsEl.replaceChildren();
          seeMoreEl.hidden = true;
          return;
        }

        currentRanked = ranked;
        currentInputs = inputs;
        visibleCount = Math.min(12, currentRanked.length);
        statusEl.textContent = `${currentRanked.length} ranked matches found. Showing the strongest ${visibleCount}.`;
        saveListEl.hidden = false;
        renderVisibleResults();
      }

      seeMoreEl.addEventListener("click", () => {
        visibleCount = Math.min(visibleCount + 12, currentRanked.length);
        renderVisibleResults();
      });

      resultsEl.addEventListener("toggle", (event) => {
        const openedDetails = event.target;
        if (!(openedDetails instanceof HTMLDetailsElement) || !openedDetails.classList.contains("plant-details") || !openedDetails.open) return;
        resultsEl.querySelectorAll(".plant-details[open]").forEach((details) => {
          if (details !== openedDetails) details.open = false;
        });
      }, true);

      saveListEl.addEventListener("click", () => {
        if (!currentInputs || currentRanked.length === 0) return;
        const lines = [
          `What Should I Grow - picks for ${currentInputs.zip} / zone ${currentInputs.zone}`,
          "",
          ...currentRanked.slice(0, visibleCount).map((entry, index) => {
            const fit = overallFit(entry.score);
            return `${index + 1}. ${entry.plant.name} (${fit.percent}% ${fit.label}) - ${explainPlant(entry.plant, currentInputs)}`;
          })
        ];
        const blob = new Blob([lines.join("\n")], { type: "text/plain" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = `what-should-i-grow-${currentInputs.zip}.txt`;
        link.click();
        URL.revokeObjectURL(url);
      });

      zipEl.addEventListener("input", () => {
        const zip = zipEl.value.trim();
        clearTimeout(zoneLookupTimer);
        zonePreviewEl.hidden = true;
        zonePreviewEl.textContent = "";
        zonePreviewEl.classList.remove("is-error");
        if (!/^\d{5}$/.test(zip)) return;
        zonePreviewEl.hidden = false;
        zonePreviewEl.textContent = "Checking USDA zone...";
        zoneLookupTimer = setTimeout(async () => {
          try {
            const zoneData = await lookupZone(zip);
            zonePreviewEl.textContent = `Zone ${zoneData.zone} detected`;
            zonePreviewEl.classList.remove("is-error");
          } catch (error) {
            zonePreviewEl.textContent = "Zone lookup needs another try";
            zonePreviewEl.classList.add("is-error");
          }
        }, 350);
      });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const formData = new FormData(form);
        const zip = String(formData.get("zip") ?? "").trim();
        const soilInput = String(formData.get("soil"));

        if (!/^\d{5}$/.test(zip)) {
          statusEl.textContent = "Enter a five-digit U.S. ZIP code.";
          return;
        }

        statusEl.textContent = "Looking up your USDA hardiness zone...";
        resultsEl.replaceChildren();
        seeMoreEl.hidden = true;
        saveListEl.hidden = true;

        try {
          const zoneData = await lookupZone(zip);
          const inputs = {
            zip,
            zone: zoneData.zone,
            sun: String(formData.get("sun")),
            soil: soilInput === "not-sure" ? "loam" : soilInput,
            water: String(formData.get("water")),
            goal: String(formData.get("goal")),
            form: String(formData.get("form"))
          };
          statusEl.textContent = soilInput === "not-sure" ? "Soil set to loam because you selected not sure." : "";
          renderResults(zoneData, inputs);
        } catch (error) {
          titleEl.textContent = "The zone lookup did not respond.";
          zoneNoteEl.textContent = "Try again in a moment, or swap the lookup function to another USDA-zone provider.";
          statusEl.textContent = "No recommendations shown because hardiness zone is required for ranking.";
        }
      });
    </script>
  </body>
</html>
