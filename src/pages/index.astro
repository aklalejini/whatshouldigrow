---
import { getCollection } from "astro:content";
import plants from "../data/plants.json";
import partners from "../data/affiliatePartners.json";
import plantArtEntries from "../data/plantArt.json";
import plantMetrics from "../data/plantMetrics.json";
import plantRelationships from "../data/plantRelationships.json";
import {
  DEFAULT_SOCIAL_IMAGE,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_URL,
  siteUrl
} from "../lib/site";
import "../styles/global.css";

const plantCount = Array.isArray(plants) ? plants.length : 0;
const plantMetricEntries = Object.values(plantMetrics);
const poundYieldMetricCount = plantMetricEntries.filter((metric) => metric.yieldLbsMin !== null && metric.yieldLbsMax !== null).length;
const blogEntries = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const blogArticles = blogEntries.map((entry) => ({
  slug: entry.data.slug,
  title: entry.data.title,
  excerpt: entry.data.excerpt,
  category: entry.data.category,
  heroImage: entry.data.heroImage,
  heroAlt: entry.data.heroAlt,
  tags: entry.data.tags,
  pubDate: entry.data.pubDate.toISOString(),
  bodyText: entry.body ?? "",
  url: `/blog/${entry.data.slug}/`
}));
const stripMarkdown = (value) =>
  String(value)
    .replace(/<[^>]*>/g, " ")
    .replace(/[#*_`>\-[\]()]/g, " ");
const blogSearchData = blogArticles.map((article) => ({
  slug: article.slug,
  searchableText: [article.title, article.excerpt, article.category, article.tags.join(" "), article.bodyText]
    .map(stripMarkdown)
    .join(" ")
    .toLowerCase()
}));
const canonicalUrl = siteUrl("/");
const socialImageUrl = siteUrl(DEFAULT_SOCIAL_IMAGE);
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  potentialAction: {
    "@type": "SearchAction",
    target: `${SITE_URL}/?q={search_term_string}#blog`,
    "query-input": "required name=search_term_string"
  }
};
const webAppJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: SITE_NAME,
  url: canonicalUrl,
  applicationCategory: "LifestyleApplication",
  operatingSystem: "Any",
  description: `Match ${plantCount} practical plant options to a ZIP code, light, soil, water, and garden goal, then build a ZIP-based planting calendar.`
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={SITE_DESCRIPTION}
    />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${SITE_NAME} | ZIP-Based Plant Matcher`} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${SITE_NAME} | ZIP-Based Plant Matcher`} />
    <meta name="twitter:description" content={SITE_DESCRIPTION} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="impact-site-verification" value="253e3bdc-6e6e-4933-ba92-e7cd3d20b912" />
    <meta name="impact-site-verification" value="22072aac-507f-40ba-8639-33d77c2e5eb1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,750&family=Inter:wght@400;500;650;750;850&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/plantbyzip-icon.png" />
    <link rel="apple-touch-icon" href="/brand/plantbyzip-icon.png" />
    <title>{SITE_NAME} | ZIP-Based Plant Matcher and Gardening Guide</title>
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(webAppJsonLd)}></script>
  </head>
  <body>
    <main class="app-shell">
      <nav class="site-tabs" aria-label="Primary sections" role="tablist">
        <button
          class="site-tab is-active"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="matcher-view"
          data-view="matcher"
        >
          Plant matcher
        </button>
        <button
          class="site-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="calendar-view"
          data-view="calendar"
        >
          Calendar
        </button>
        <button
          class="site-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="screener-view"
          data-view="screener"
        >
          Screener
        </button>
        <button
          class="site-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="blog-view"
          data-view="blog"
        >
          Blog
        </button>
      </nav>

      <div id="matcher-view" class="view-panel is-active" role="tabpanel" data-view-panel="matcher">
      <section class="workspace" aria-labelledby="app-title">
        <div class="intro-panel">
          <div class="brand-lockup" aria-label={SITE_NAME}>
            <img class="brand-mark" src="/brand/plantbyzip-icon.png" alt="" aria-hidden="true" />
            <span>{SITE_NAME}</span>
          </div>
          <h1 id="app-title">What should I grow here?</h1>
          <p>
            Enter your ZIP code and a few garden conditions. Get a ranked field-guide of edible,
            wildlife-friendly, useful, and good-looking plants that are actually worth considering.
          </p>
          <figure class="hero-plate hero-gallery" aria-hidden="true">
            <span class="hero-frame" style="--hero-image: url('/plant-art/fig.webp'); --i: 0"></span>
            <span class="hero-frame" style="--hero-image: url('/plant-art/blueberry.webp'); --i: 1"></span>
            <span class="hero-frame" style="--hero-image: url('/plant-art/persimmon.webp'); --i: 2"></span>
            <span class="hero-frame" style="--hero-image: url('/plant-art/plum.webp'); --i: 3"></span>
            <span class="hero-frame" style="--hero-image: url('/plant-art/elderberry.webp'); --i: 4"></span>
            <span class="hero-specimen hero-specimen-a is-first" style="--specimen-image: url('/plant-art/serviceberry.webp'); --i: 0"></span>
            <span class="hero-specimen hero-specimen-b is-first" style="--specimen-image: url('/plant-art/raspberry.webp'); --i: 0"></span>
            <span class="hero-specimen hero-specimen-c is-first" style="--specimen-image: url('/plant-art/generic-vine.webp'); --i: 0"></span>
            <span class="hero-specimen hero-specimen-a" style="--specimen-image: url('/plant-art/grape.webp'); --i: 1"></span>
            <span class="hero-specimen hero-specimen-b" style="--specimen-image: url('/plant-art/hardy-kiwi.webp'); --i: 1"></span>
            <span class="hero-specimen hero-specimen-c" style="--specimen-image: url('/plant-art/gooseberry.webp'); --i: 1"></span>
            <span class="hero-specimen hero-specimen-a" style="--specimen-image: url('/plant-art/plum.webp'); --i: 2"></span>
            <span class="hero-specimen hero-specimen-b" style="--specimen-image: url('/plant-art/maypop-passionfruit.webp'); --i: 2"></span>
            <span class="hero-specimen hero-specimen-c" style="--specimen-image: url('/plant-art/aronia.webp'); --i: 2"></span>
            <span class="hero-specimen hero-specimen-a" style="--specimen-image: url('/plant-art/blackberry.webp'); --i: 3"></span>
            <span class="hero-specimen hero-specimen-b" style="--specimen-image: url('/plant-art/blueberry.webp'); --i: 3"></span>
            <span class="hero-specimen hero-specimen-c" style="--specimen-image: url('/plant-art/elderberry.webp'); --i: 3"></span>
            <span class="hero-specimen hero-specimen-a" style="--specimen-image: url('/plant-art/fig.webp'); --i: 4"></span>
            <span class="hero-specimen hero-specimen-b" style="--specimen-image: url('/plant-art/persimmon.webp'); --i: 4"></span>
            <span class="hero-specimen hero-specimen-c" style="--specimen-image: url('/plant-art/generic-flower-herb.webp'); --i: 4"></span>
          </figure>
        </div>

        <form class="matcher-panel" id="matcher-form">
          <div class="form-heading">
            <p class="eyebrow">Plot conditions</p>
            <h2>Start with your place.</h2>
          </div>
          <div class="zip-row">
            <div>
              <label for="zip">ZIP code</label>
              <p>Hardiness zone anchors the ranking.</p>
            </div>
            <input
              id="zip"
              name="zip"
              inputmode="numeric"
              pattern="[0-9]{5}"
              maxlength="5"
              autocomplete="postal-code"
              placeholder="75001"
              required
            />
            <div id="zone-preview" class="zone-preview" hidden></div>
          </div>

          <fieldset>
            <legend>Sun exposure</legend>
            <div class="segmented">
              <label>
                <input type="radio" name="sun" value="full" checked />
                <span class="option-card"><span class="option-label">Full</span><span class="option-help">6+ hours</span></span>
              </label>
              <label>
                <input type="radio" name="sun" value="partial" />
                <span class="option-card"><span class="option-label">Partial</span><span class="option-help">3-6 hours</span></span>
              </label>
              <label>
                <input type="radio" name="sun" value="shade" />
                <span class="option-card"><span class="option-label">Shade</span><span class="option-help">Mostly indirect</span></span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Soil type</legend>
            <div class="segmented">
              <label>
                <input type="radio" name="soil" value="clay" />
                <span class="option-card"><span class="option-label">Clay</span><span class="option-help">Sticky, holds water</span></span>
              </label>
              <label>
                <input type="radio" name="soil" value="loam" checked />
                <span class="option-card"><span class="option-label">Loam</span><span class="option-help">Crumbly, balanced</span></span>
              </label>
              <label>
                <input type="radio" name="soil" value="sandy" />
                <span class="option-card"><span class="option-label">Sandy</span><span class="option-help">Gritty, drains fast</span></span>
              </label>
              <label>
                <input type="radio" name="soil" value="not-sure" />
                <span class="option-card"><span class="option-label">Not sure</span><span class="option-help">Uses loam</span></span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Water availability</legend>
            <div class="segmented">
              <label>
                <input type="radio" name="water" value="low" />
                <span class="option-card"><span class="option-label">Low</span><span class="option-help">Dry spells</span></span>
              </label>
              <label>
                <input type="radio" name="water" value="medium" checked />
                <span class="option-card"><span class="option-label">Medium</span><span class="option-help">Normal watering</span></span>
              </label>
              <label>
                <input type="radio" name="water" value="high" />
                <span class="option-card"><span class="option-label">High</span><span class="option-help">Moist beds</span></span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Goal</legend>
            <div class="segmented goal-grid">
              <label>
                <input type="radio" name="goal" value="fruit" checked />
                <span class="option-card"><span class="option-label">Fruit</span><span class="option-help">Edible trees &amp; berries</span></span>
              </label>
              <label>
                <input type="radio" name="goal" value="vegetables-herbs" />
                <span class="option-card"><span class="option-label">Vegetables &amp; herbs</span><span class="option-help">Kitchen crops</span></span>
              </label>
              <label>
                <input type="radio" name="goal" value="pollinators-wildlife" />
                <span class="option-card"><span class="option-label">Pollinators &amp; wildlife</span><span class="option-help">For bees &amp; birds</span></span>
              </label>
              <label>
                <input type="radio" name="goal" value="curb-appeal" />
                <span class="option-card"><span class="option-label">Curb appeal &amp; color</span><span class="option-help">Front-yard color</span></span>
              </label>
              <label>
                <input type="radio" name="goal" value="privacy-screening" />
                <span class="option-card"><span class="option-label">Privacy &amp; screening</span><span class="option-help">Screens &amp; buffers</span></span>
              </label>
              <label>
                <input type="radio" name="goal" value="native-plants" />
                <span class="option-card"><span class="option-label">Native plants</span><span class="option-help">Habitat &amp; region fit</span></span>
              </label>
            </div>
          </fieldset>

          <button class="match-button" type="submit">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M11 20a9 9 0 1 1 7.03-3.38l3.17 3.17-1.41 1.41-3.17-3.17A8.96 8.96 0 0 1 11 20Zm0-2a7 7 0 1 0 0-14 7 7 0 0 0 0 14Z"></path>
            </svg>
            Find plants
          </button>
        </form>
      </section>

      <section class="results-band" aria-live="polite">
        <div class="results-head">
          <div>
            <p class="eyebrow">Ranked picks</p>
            <h2 id="results-title">Enter a ZIP code to start.</h2>
          </div>
          <p id="zone-note">Not sure about soil defaults to loam. Recommendations are practical starting points, not local extension advice.</p>
        </div>
        <div id="status" class="status"></div>
        <ol id="results" class="results-grid"></ol>
        <div class="results-actions">
          <button id="save-list" class="save-list-button" type="button" hidden>Save this list</button>
          <button id="see-more" class="see-more-button" type="button" hidden>See more results</button>
        </div>
      </section>

      <section class="public-notes" aria-labelledby="public-notes-title">
        <div>
          <p class="eyebrow">Before you plant</p>
          <h2 id="public-notes-title">Use these recommendations as a strong starting point.</h2>
        </div>
        <div class="note-grid">
          <article>
            <h3>Local conditions still matter</h3>
            <p>
              Rankings use ZIP-based hardiness, light, soil, water, and goal fit. Microclimates,
              drainage, pests, chill hours, and local invasive lists can change the final answer.
            </p>
          </article>
          <article>
            <h3>Privacy basics</h3>
            <p>
              The matcher does not ask for an account or save a garden profile. ZIP codes are used
              in the browser to look up a USDA hardiness zone for the current search.
            </p>
          </article>
          <article>
            <h3>Nursery links</h3>
            <p>
              Nursery search links are placeholders while Plant by ZIP is being tested. They are
              not paid placements and do not affect the plant ranking.
            </p>
          </article>
        </div>
      </section>
      </div>

      <section
        id="calendar-view"
        class="view-panel calendar-view"
        role="tabpanel"
        data-view-panel="calendar"
        aria-labelledby="calendar-title"
        hidden
      >
        <div class="calendar-shell">
          <header class="calendar-header">
            <div>
              <p class="eyebrow">ZIP planting planner</p>
              <h1 id="calendar-title">Planting Calendar</h1>
              <p>
                Enter a ZIP code to turn the plant database into estimated seed-starting,
                transplanting, direct-sow, and nursery planting windows for your hardiness zone.
              </p>
            </div>
            <form id="calendar-form" class="calendar-zip-card">
              <label for="calendar-zip">ZIP code</label>
              <div class="calendar-zip-row">
                <input
                  id="calendar-zip"
                  name="calendar-zip"
                  inputmode="numeric"
                  pattern="[0-9]{5}"
                  maxlength="5"
                  autocomplete="postal-code"
                  placeholder="75001"
                  required
                />
                <button type="submit">Build calendar</button>
              </div>
              <p id="calendar-status">Enter a five-digit U.S. ZIP code to estimate local windows.</p>
            </form>
          </header>

          <section class="calendar-dashboard" aria-label="Calendar climate summary">
            <div>
              <span>Zone</span>
              <strong id="calendar-zone-value">--</strong>
              <small id="calendar-temp-value">USDA hardiness</small>
            </div>
            <div>
              <span>Last frost</span>
              <strong id="calendar-last-frost">--</strong>
              <small>spring estimate</small>
            </div>
            <div>
              <span>First frost</span>
              <strong id="calendar-first-frost">--</strong>
              <small>fall estimate</small>
            </div>
            <div>
              <span>Growing season</span>
              <strong id="calendar-season-length">--</strong>
              <small>frost-free days</small>
            </div>
          </section>

          <section class="calendar-now" aria-label="Right now in this calendar">
            <div class="calendar-now-copy">
              <p class="eyebrow">Right now</p>
              <h2 id="calendar-now-title">Today in your zone</h2>
              <p id="calendar-now-summary">Build a calendar to see what overlaps this week.</p>
            </div>
            <div id="calendar-now-list" class="calendar-now-list">
              <p>Current planting windows will appear here after lookup.</p>
            </div>
          </section>

          <section class="calendar-controls" aria-label="Calendar detail filters">
            <label class="calendar-field" for="calendar-season">
              <span>Detail window</span>
              <select id="calendar-season">
                <option value="all">Full year</option>
                <option value="next">Next 45 days</option>
                <option value="spring">Spring</option>
                <option value="fall">Fall</option>
              </select>
            </label>
            <label class="calendar-field" for="calendar-method">
              <span>Method</span>
              <select id="calendar-method">
                <option value="all">All methods</option>
                <option value="indoors">Start indoors</option>
                <option value="direct">Direct sow</option>
                <option value="transplant">Transplant</option>
                <option value="nursery">Plant nursery stock</option>
              </select>
            </label>
          </section>

          <section class="calendar-visual" aria-label="Year at a glance">
            <div class="calendar-visual-head">
              <div>
                <p class="eyebrow">Year at a glance</p>
                <h2>Planting timeline</h2>
              </div>
              <p id="calendar-visual-summary">A horizontal view will appear after ZIP lookup.</p>
            </div>

            <div class="calendar-set-bar">
              <div>
                <p class="eyebrow">Plant set</p>
                <h3>Focus the year</h3>
              </div>
              <div id="calendar-set-tabs" class="calendar-set-tabs" role="group" aria-label="Plant set">
                <button type="button" class="is-active" data-calendar-set="all" aria-pressed="true">All</button>
                <button type="button" data-calendar-set="kitchen" aria-pressed="false">Kitchen</button>
                <button type="button" data-calendar-set="fruit" aria-pressed="false">Fruit</button>
                <button type="button" data-calendar-set="pollinator" aria-pressed="false">Pollinators</button>
                <button type="button" data-calendar-set="native" aria-pressed="false">Natives</button>
                <button type="button" data-calendar-set="containers" aria-pressed="false">Containers</button>
                <button type="button" data-calendar-set="quick" aria-pressed="false">Quick</button>
              </div>
              <select id="calendar-set" hidden aria-hidden="true">
                <option value="all">All zone-fit plants</option>
                <option value="kitchen">Kitchen garden</option>
                <option value="fruit">Fruit and berries</option>
                <option value="pollinator">Pollinator plants</option>
                <option value="native">Native cues</option>
                <option value="containers">Container-friendly</option>
                <option value="quick">Quick payoff</option>
              </select>
            </div>

            <div class="calendar-legend" aria-label="Timeline legend">
              <span><i class="calendar-legend-swatch calendar-method-indoors"></i>Start indoors</span>
              <span><i class="calendar-legend-swatch calendar-method-direct"></i>Direct sow</span>
              <span><i class="calendar-legend-swatch calendar-method-transplant"></i>Transplant</span>
              <span><i class="calendar-legend-swatch calendar-method-nursery"></i>Nursery stock</span>
            </div>

            <div id="calendar-heatmap" class="calendar-heatmap" aria-label="Monthly planting activity"></div>
            <div id="calendar-mobile-plan" class="calendar-mobile-plan" aria-live="polite"></div>
            <div id="calendar-gantt" class="calendar-gantt" aria-label="Planting timeline rows"></div>
          </section>

          <section class="calendar-layout" aria-label="Planting calendar results">
            <aside class="calendar-next">
              <div class="calendar-panel-head">
                <p class="eyebrow">Next moves</p>
                <h2>Coming up</h2>
              </div>
              <div id="calendar-next-list" class="calendar-next-list">
                <p>Build a calendar to see near-term planting tasks.</p>
              </div>
            </aside>

            <section class="calendar-timeline" aria-label="Planting window timeline">
              <div class="calendar-timeline-head">
                <div>
                  <p class="eyebrow">Month detail</p>
                  <h2 id="calendar-results-title">Waiting on ZIP</h2>
                </div>
                <p id="calendar-summary">Frost-based windows will appear here after lookup.</p>
              </div>
              <div id="calendar-month-strip" class="calendar-month-strip" role="group" aria-label="Month filter"></div>
              <div id="calendar-events" class="calendar-event-list"></div>
              <p id="calendar-empty" class="calendar-empty" hidden>No planting windows match those filters.</p>
            </section>
          </section>

          <p class="calendar-method-note">
            Planning dates are approximate. Use local extension guidance, seed packet directions,
            soil temperature, and the near-term forecast before planting.
          </p>
        </div>
      </section>

      <section
        id="screener-view"
        class="view-panel screener-view"
        role="tabpanel"
        data-view-panel="screener"
        aria-labelledby="screener-title"
        hidden
      >
        <div class="screener-shell">
          <header class="screener-header">
            <div>
              <p class="eyebrow">Plant research table</p>
              <h1 id="screener-title">Plant Screener</h1>
              <p>
                Screen the full Plant by ZIP database like a compact market table:
                filter by growing needs, sort by useful signals, and jump into any plant profile.
              </p>
            </div>
            <div class="screener-metrics" aria-label="Screener database summary">
              <div>
                <strong id="screener-visible-count">{plantCount}</strong>
                <span>matches</span>
              </div>
              <div>
                <strong id="screener-type-count">0</strong>
                <span>plant types</span>
              </div>
              <div>
                <strong>{poundYieldMetricCount}</strong>
                <span>lb returns</span>
              </div>
              <div>
                <strong id="screener-relation-count">0</strong>
                <span>with pairings</span>
              </div>
            </div>
          </header>

          <section class="screener-controls" aria-label="Plant screener filters">
            <div class="screener-search">
              <label for="screener-search">Search</label>
              <input id="screener-search" type="search" placeholder="Name, trait, harvest, source" />
            </div>
            <label class="screener-field" for="screener-type">
              <span>Type/form</span>
              <select id="screener-type">
                <option value="">Any type/form</option>
              </select>
            </label>
            <label class="screener-field" for="screener-zone">
              <span>Zone fit</span>
              <select id="screener-zone">
                <option value="">Any zone</option>
              </select>
            </label>
            <label class="screener-field" for="screener-horizon">
              <span>Time horizon</span>
              <select id="screener-horizon">
                <option value="">Any horizon</option>
