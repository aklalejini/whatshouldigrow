---
import AnalyticsEvents from "../../components/AnalyticsEvents.astro";
import ZoneIntentArticle from "../../components/ZoneIntentArticle.astro";
import plantMetrics from "../../data/plantMetrics.json";
import plants from "../../data/plants.json";
import { DEFAULT_SOCIAL_IMAGE, SITE_NAME, SITE_URL, siteUrl } from "../../lib/site";
import {
  plantsForZoneTarget,
  relatedZoneTargets,
  targetsForFamily
} from "../../lib/zonePageData";
import "../../styles/global.css";

export function getStaticPaths() {
  return targetsForFamily("native-plants").map((target) => ({
    params: { zone: target.zoneSlug },
    props: { target }
  }));
}

const { target } = Astro.props;
const canonicalUrl = siteUrl(target.path);
const socialImageUrl = siteUrl(DEFAULT_SOCIAL_IMAGE);
const entries = plantsForZoneTarget(target, plants, plantMetrics);
const relatedTargets = relatedZoneTargets(target);
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: SITE_URL },
    { "@type": "ListItem", position: 2, name: "Native plants", item: siteUrl("/native-plants/") },
    { "@type": "ListItem", position: 3, name: target.title, item: canonicalUrl }
  ]
};
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: target.title,
  description: target.description,
  url: canonicalUrl,
  numberOfItems: entries.slice(0, 24).length,
  itemListElement: entries.slice(0, 24).map(({ plant }, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: plant.name,
    url: siteUrl(`/plants/${plant.id}/`)
  }))
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={target.description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${target.title} | ${SITE_NAME}`} />
    <meta property="og:description" content={target.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${target.title} | ${SITE_NAME}`} />
    <meta name="twitter:description" content={target.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,750&family=Inter:wght@400;500;650;750;850&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/plantbyzip-icon.png" />
    <link rel="apple-touch-icon" href="/brand/plantbyzip-icon.png" />
    <title>{target.title} | {SITE_NAME}</title>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)}></script>
  </head>
  <body>
    <main class="app-shell">
      <nav class="site-tabs" aria-label="Primary sections">
        <a class="site-tab is-active" aria-current="page" href="/">Plant matcher</a>
        <a class="site-tab" href="/planting-calendar/">Calendar</a>
        <a class="site-tab" href="/#zone-map">Zone map</a>
        <a class="site-tab" href="/#screener">Screener</a>
        <a class="site-tab" href="/blog/">Blog</a>
      </nav>

      <ZoneIntentArticle target={target} entries={entries} relatedTargets={relatedTargets} />
    </main>
    <AnalyticsEvents pageType="zone_page" topic={target.family} zone={target.zone} />
  </body>
</html>
