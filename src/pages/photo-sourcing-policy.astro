---
import AnalyticsEvents from "../components/AnalyticsEvents.astro";
import { DEFAULT_SOCIAL_IMAGE, SITE_NAME, SITE_URL, siteUrl } from "../lib/site";
import "../styles/global.css";

const canonicalUrl = siteUrl("/photo-sourcing-policy/");
const socialImageUrl = siteUrl(DEFAULT_SOCIAL_IMAGE);
const description = "How Plant by ZIP chooses, credits, and uses real plant photos and botanical art.";
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: SITE_URL },
    { "@type": "ListItem", position: 2, name: "Photo Sourcing Policy", item: canonicalUrl }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`Photo Sourcing Policy | ${SITE_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`Photo Sourcing Policy | ${SITE_NAME}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,750&family=Inter:wght@400;500;650;750;850&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/plantbyzip-icon.png" />
    <link rel="apple-touch-icon" href="/brand/plantbyzip-icon.png" />
    <title>Photo Sourcing Policy | {SITE_NAME}</title>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>
  </head>
  <body>
    <AnalyticsEvents pageType="trust_page" topic="photo-sourcing-policy" />
    <main class="app-shell">
      <nav class="site-tabs" aria-label="Primary sections">
        <a class="site-tab" href="/">Plant matcher</a>
        <a class="site-tab" href="/#screener">Screener</a>
        <a class="site-tab" href="/planting-calendar/">Calendar</a>
        <a class="site-tab" href="/#zone-map">Zone map</a>
        <a class="site-tab" href="/plants/">Plants</a>
        <a class="site-tab" href="/blog/">Guides</a>
      </nav>

      <article class="trust-page">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Plant by ZIP</a><span aria-hidden="true">/</span><span>Photo Sourcing Policy</span>
        </nav>
        <header class="trust-hero">
          <p class="eyebrow">Photo sourcing</p>
          <h1>Plant photos are chosen to help gardeners recognize the living plant.</h1>
          <p>
            Plant profile pages use real photos for garden reference and botanical art for the site identity, cards, and visual browsing.
          </p>
        </header>
        <section class="trust-grid" aria-label="Photo sourcing standards">
          <article>
            <h2>Selection</h2>
            <p>Primary photos should show living plant structure where possible: leaves, stems, flowers, fruit, habit, or the part gardeners need to identify.</p>
          </article>
          <article>
            <h2>Representative photos</h2>
            <p>When exact cultivar photos are not available, the closest useful species or crop photo may be used and credited as a representative reference.</p>
          </article>
          <article>
            <h2>Credits</h2>
            <p>Photo source URLs, credits, licenses, captions, and notes are stored in the plant photo metadata and shown on plant profile pages.</p>
          </article>
        </section>
        <section class="trust-panel">
          <h2>Optimization</h2>
          <p>
            The site keeps source images for traceability and serves optimized AVIF/WebP variants to browsers for faster loading.
            Duplicate representative images may share one canonical URL so repeat pages can use the browser cache.
          </p>
        </section>
      </article>
    </main>
  </body>
</html>
