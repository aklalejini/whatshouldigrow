---
import plants from "../../data/plants.json";
import partners from "../../data/affiliatePartners.json";
import plantArtEntries from "../../data/plantArt.json";
import plantMetricSources from "../../data/plantMetricSources.json";
import plantMetrics from "../../data/plantMetrics.json";
import plantRelationships from "../../data/plantRelationships.json";
import {
  DEFAULT_SOCIAL_IMAGE,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_URL,
  siteUrl
} from "../../lib/site";
import {
  formatGoal,
  formatGoalList,
  formatList,
  goalLabels,
  plantArtEntry,
  plantKind,
  plantPhotoStyle,
  plantUrl,
  relationshipEntriesForPlant,
  relationshipTypeLabels,
  sentenceCase
} from "../../lib/plantUtils";
import "../../styles/global.css";

export function getStaticPaths() {
  return plants.map((plant) => ({
    params: { id: plant.id },
    props: { plant }
  }));
}

const { plant } = Astro.props;
const metrics = plantMetrics[plant.id] ?? {};
const metricDisplay = metrics.display ?? {};
const metricSources = (metrics.sourceKeys ?? [])
  .map((key) => ({ key, ...(plantMetricSources[key] ?? {}) }))
  .filter((source) => source.title && source.url);
const artEntry = plantArtEntry(plant, plantArtEntries);
const artId = artEntry?.id ?? "generic-fruit";
const kind = plantKind(plant);
const hasImage = Boolean(artEntry?.image);
const photoStyle = plantPhotoStyle(artEntry);
const canonicalUrl = siteUrl(plantUrl(plant));
const socialImageUrl = hasImage ? siteUrl(`/plant-art/${artEntry.image}`) : siteUrl(DEFAULT_SOCIAL_IMAGE);
const metricDescription = metrics.yieldLbsMin !== null && metricDisplay.yieldLbs
  ? ` Planning metrics include ${metricDisplay.yieldLbs}, ${metricDisplay.spacing}, and ${metricDisplay.firstOutput}.`
  : "";
const description = `${plant.name} growing profile for ${SITE_NAME}: zones ${plant.zones[0]}-${plant.zones[1]}, ${formatList(plant.sun)} light, ${formatList(plant.soils)} soil, ${plant.water} water, and practical plant pairings.${metricDescription}`;
const allRelationshipEntries = relationshipEntriesForPlant(plant, plantRelationships, plants);
const relationshipEntries = allRelationshipEntries.slice(0, 5);
const relatedPlantCount = new Set(allRelationshipEntries.flatMap(({ relatedPlants }) => relatedPlants.map((relatedPlant) => relatedPlant.id))).size;
const partner = partners[plant.partner] ?? null;
const partnerName = partner?.name ?? sentenceCase(String(plant.partner ?? "source").replaceAll("-", " "));
const totalGoalCount = Object.keys(goalLabels).length;
const hasEdibleGoal = plant.goals.includes("fruit") || plant.goals.includes("vegetables-herbs");
const hasNativeGoal = plant.goals.includes("low-maintenance-natives")
  || plant.traits.some((trait) => /\bnative\b/i.test(trait))
  || /\bnative\b/i.test(plant.notes);

function partnerSearchHref(source, query) {
  if (!source?.searchUrl || !query) return "";
  const url = source.searchUrl.replace("{query}", encodeURIComponent(query));
  const affiliateParam = source.affiliateParam?.replace(/^[?&]/, "");
  if (!affiliateParam) return url;
  return `${url}${url.includes("?") ? "&" : "?"}${affiliateParam}`;
}

function zoneToNumber(zone) {
  const [, number = "0", suffix = ""] = String(zone).match(/^(\d+)([ab])?$/) ?? [];
  return Number(number) + (suffix === "b" ? 0.5 : 0);
}

function rangesOverlap(first, second) {
  return zoneToNumber(first.zones[0]) <= zoneToNumber(second.zones[1])
    && zoneToNumber(second.zones[0]) <= zoneToNumber(first.zones[1]);
}

const tokenStopWords = new Set(["plant", "tree", "shrub", "bush", "fruit", "hardy", "common", "dwarf", "american"]);

function comparisonTokens(entry) {
  return new Set(`${entry.name} ${entry.query ?? ""}`
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, " ")
    .split(" ")
    .filter((token) => token.length > 3 && !tokenStopWords.has(token)));
}

const plantTokens = comparisonTokens(plant);

function peerReasonForPlant(candidate, context) {
  const candidateMetrics = plantMetrics[candidate.id] ?? {};
  const candidateYield = candidateMetrics.yieldLbsMax;
  const plantYield = metrics.yieldLbsMax;
  if (context.sharedNameTokens > 0) {
    return "Same crop family or cultivar set; compare yield, spacing, and source availability.";
  }
  if (candidateYield !== null && candidateYield !== undefined && plantYield !== null && plantYield !== undefined) {
    if (candidateYield > plantYield * 1.2) return "Higher sourced pound-return range with similar planning context.";
    if (candidateYield < plantYield * 0.8) return "Lower pound-return range, but may win on fit, flavor, or form.";
  }
  if (
    candidateMetrics.matureSpreadFtMax !== null
    && candidateMetrics.matureSpreadFtMax !== undefined
    && metrics.matureSpreadFtMax !== null
    && metrics.matureSpreadFtMax !== undefined
    && candidateMetrics.matureSpreadFtMax < metrics.matureSpreadFtMax * 0.75
  ) {
    return "Smaller mature footprint for tighter beds or mixed plantings.";
  }
  if (candidate.type === plant.type && context.sharedGoals > 0) {
    return `Same form with ${context.sharedGoals} overlapping goal${context.sharedGoals === 1 ? "" : "s"}.`;
  }
  if (context.sharedSun > 0 && context.sharedSoils > 0) {
    return "Similar light and soil needs; practical substitute in the same site.";
  }
  return "Comparable database profile; check site fit before choosing.";
}

const comparablePlants = plants
  .filter((candidate) => candidate.id !== plant.id)
  .map((candidate) => {
    const candidateTokens = comparisonTokens(candidate);
    const sharedNameTokens = Array.from(plantTokens).filter((token) => candidateTokens.has(token)).length;
    const sharedGoals = candidate.goals.filter((goal) => plant.goals.includes(goal)).length;
    const sharedSun = candidate.sun.filter((sun) => plant.sun.includes(sun)).length;
    const sharedSoils = candidate.soils.filter((soil) => plant.soils.includes(soil)).length;
    const score = (candidate.type === plant.type ? 4 : 0)
      + sharedNameTokens * 4
      + sharedGoals * 1.8
      + sharedSun
      + sharedSoils
      + (candidate.water === plant.water ? 1.2 : 0)
      + (rangesOverlap(plant, candidate) ? 1 : 0);
    return {
      candidate,
      score,
      reason: peerReasonForPlant(candidate, { sharedGoals, sharedNameTokens, sharedSun, sharedSoils })
    };
  })
  .filter(({ score }) => score > 3)
  .sort((a, b) => b.score - a.score || a.candidate.name.localeCompare(b.candidate.name))
  .slice(0, 4);

function planningNotesForPlant(entry) {
  const notes = [
    `Match the site first: ${formatList(entry.sun)} light, ${formatList(entry.soils)} soil, and ${entry.water} water.`
  ];
  if (metricDisplay.spacing) {
    notes.push(`Use ${metricDisplay.spacing} as the first spacing model; adjust for hedges, trellises, containers, or local guidance.`);
  }
  if (metricDisplay.matureSize) {
    notes.push(`Plan around mature size: ${metricDisplay.matureSize}.`);
  }
  if (hasEdibleGoal) {
    notes.push(`For harvest planning, treat "${entry.harvest}" and ${metricDisplay.output ?? "the listed output range"} as planning ranges, not guarantees.`);
  }
  if (/another|pair|pollinator|compatible|self-fertile|nearby/i.test(`${entry.notes} ${entry.traits.join(" ")}`)) {
    notes.push("Plan pollination or companion context before planting; nearby varieties can matter for fruit set.");
  }
  if (entry.goals.includes("privacy-screening")) {
    notes.push("For screens and hedges, confirm mature size and spacing with the nursery label or local extension guidance.");
  }
  if (hasNativeGoal) {
    notes.push("Native and low-maintenance cues are starting points; confirm regional nativity and local invasive guidance.");
  }
  if (metrics.dataConfidence === "low") {
    notes.push("Quantitative data quality is low for this record; verify before buying or planting at scale.");
  }
  notes.push("Local drainage, pests, chill hours, wildlife pressure, and microclimates can change the result.");
  return Array.from(new Set(notes)).slice(0, 5);
}

function metricNumber(value) {
  if (value === null || value === undefined) return "";
  return Number.isInteger(value) ? String(value) : String(Math.round(value * 10) / 10);
}

function metricRange(min, max, suffix = "", fallback = "Needs source") {
  if (min === null || min === undefined || max === null || max === undefined) return fallback;
  if (min === max) return `${metricNumber(min)}${suffix}`;
  return `${metricNumber(min)}-${metricNumber(max)}${suffix}`;
}

function buildYieldChart(curve) {
  const width = 640;
  const height = 260;
  const left = 48;
  const right = 20;
  const top = 20;
  const bottom = 42;
  const plotWidth = width - left - right;
  const plotHeight = height - top - bottom;
  const maxYield = Math.max(1, ...curve.map((point) => point.max ?? 0));
  const xFor = (index) => left + (plotWidth * index) / Math.max(1, curve.length - 1);
  const yFor = (value) => top + plotHeight - (plotHeight * value) / maxYield;
  const highPoints = curve.map((point, index) => `${xFor(index)},${yFor(point.max)}`);
  const lowPoints = [...curve].reverse().map((point, reverseIndex) => {
    const index = curve.length - 1 - reverseIndex;
    return `${xFor(index)},${yFor(point.min)}`;
  });
  return {
    viewBox: `0 0 ${width} ${height}`,
    bandPoints: [...highPoints, ...lowPoints].join(" "),
    linePoints: curve.map((point, index) => `${xFor(index)},${yFor(point.mid)}`).join(" "),
    points: curve.map((point, index) => ({
      ...point,
      x: xFor(index),
      y: yFor(point.mid),
      label: metricRange(point.min, point.max, " lb")
    })),
    bandLabel: { x: left + 10, y: top + 18 },
    lineLabel: {
      x: Math.max(left + 8, Math.min(width - 150, xFor(curve.length - 1) - 138)),
      y: Math.max(top + 18, yFor(curve[curve.length - 1].mid) - 10)
    },
    establishmentLabel: curve[0]?.max === 0
      ? { x: left + 8, y: top + plotHeight - 12 }
      : null,
    ticks: [0, 0.25, 0.5, 0.75, 1].map((ratio) => ({
      y: top + plotHeight - plotHeight * ratio,
      label: `${metricNumber(maxYield * ratio)} lb`
    }))
  };
}

const partnerSearchUrl = partnerSearchHref(partner, plant.query);
const planningNotes = planningNotesForPlant(plant);
const yieldCurve = metrics.yieldCurve ?? [];
const hasYieldChart = yieldCurve.length > 0 && metrics.yieldLbsMin !== null && metrics.yieldLbsMax !== null;
const yieldChart = hasYieldChart ? buildYieldChart(yieldCurve) : null;
const hasPoundYield = metrics.yieldLbsMin !== null && metrics.yieldLbsMax !== null;
const primaryReturnLabel = hasPoundYield ? "Yield return" : "Output";
const primaryReturnValue = hasPoundYield ? metricDisplay.yieldLbs : metricDisplay.output;
const yieldConfidenceLabel = metrics.yieldLbsConfidence
  ? `${metrics.yieldLbsConfidence.charAt(0).toUpperCase()}${metrics.yieldLbsConfidence.slice(1)} yield confidence`
  : "No pound-yield source";
const yieldYearOne = yieldCurve.find((point) => point.year === 1);
const yieldYearFive = yieldCurve.find((point) => point.year === 5);
const yieldYearTen = yieldCurve.find((point) => point.year === 10);
const yieldYearOneNote = yieldYearOne?.max === 0
  ? "Establishment year: focus on roots before harvest."
  : "First-year estimate from the sourced curve.";
const harvestInsight = hasPoundYield
  ? `Harvest window: ${plant.harvest}. Once established, the current pound-return model uses ${metricDisplay.yieldLbs ?? "the sourced yield range"} with a harvest window of ${metricDisplay.harvestWindow ?? "seasonal timing"}.`
  : `Timing: ${plant.harvest}. This profile tracks ${metricDisplay.output ?? "the listed output range"} with a harvest or display window of ${metricDisplay.harvestWindow ?? "seasonal timing"} where defensible.`;
const returnFact = { label: primaryReturnLabel, value: primaryReturnValue ?? "Needs source", featured: hasPoundYield };
const supportingHeroFacts = [
  { label: "Zones", value: `${plant.zones[0]}-${plant.zones[1]}` },
  { label: "First output", value: metricDisplay.firstOutput ?? "Needs source" },
  { label: "Spacing", value: metricDisplay.spacing ?? "Needs source" }
];
const heroFacts = hasPoundYield
  ? [returnFact, ...supportingHeroFacts]
  : [...supportingHeroFacts, returnFact];
const cultivarRelationshipEntries = relationshipEntries.filter(({ relationship }) => (
  /pollinat|cultivar|compatible|fruit set|another/i.test(`${relationship.id} ${relationship.note}`)
));
const cultivarRelationshipIds = new Set(cultivarRelationshipEntries.map(({ relationship }) => relationship.id));
const nearbyRelationshipEntries = relationshipEntries.filter(({ relationship }) => !cultivarRelationshipIds.has(relationship.id));
const plantJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${plant.name} growing profile`,
  description,
  url: canonicalUrl,
  isPartOf: {
    "@type": "WebSite",
    name: SITE_NAME,
    url: SITE_URL
  },
  about: {
    "@type": "Thing",
    name: plant.name,
    additionalType: plant.type,
    description: plant.notes
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || SITE_DESCRIPTION} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${plant.name} | ${SITE_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${plant.name} | ${SITE_NAME}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,750&family=Inter:wght@400;500;650;750;850&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/plantbyzip-icon.png" />
    <link rel="apple-touch-icon" href="/brand/plantbyzip-icon.png" />
    <title>{plant.name} | {SITE_NAME}</title>
    <script type="application/ld+json" set:html={JSON.stringify(plantJsonLd)}></script>
  </head>
  <body>
    <main class="app-shell">
      <nav class="site-tabs" aria-label="Primary sections">
        <a class="site-tab is-active" href="/">Plant matcher</a>
        <a class="site-tab" href="/#screener">Screener</a>
        <a class="site-tab" href="/blog/">Blog</a>
      </nav>

      <article class="plant-page">
        <a class="back-link" href="/#screener">Browse all plants</a>

        <header class="plant-page-hero">
          <figure
            class={`plant-visual plant-page-visual ${kind} ${artId} ${hasImage ? "photo-plate" : ""}`}
            aria-label={`${plant.name} botanical plate`}
            style={photoStyle}
          >
            {!hasImage && <span class="plant-visual-icon"></span>}
          </figure>
          <div class="plant-page-copy">
            <p class="eyebrow">{plant.type}</p>
            <h1>{plant.name}</h1>
            <p class="plant-page-dek">{plant.notes}</p>
            <div class="plant-page-key-stats" aria-label="Plant research snapshot">
              {heroFacts.map((fact) => (
                <div class={fact.featured ? "is-primary" : ""}>
                  <span>{fact.label}</span>
                  <strong>{fact.value}</strong>
                </div>
              ))}
            </div>
            <div class="plant-page-hero-actions">
              {partnerSearchUrl && (
                <a class="plant-page-action is-primary" href={partnerSearchUrl} target="_blank" rel="noopener noreferrer">
                  Check {partnerName}
                </a>
              )}
              <button class="plant-page-action is-secondary" type="button" data-print-profile>
                Print profile
              </button>
            </div>
            <div class="plant-page-tags" aria-label="Plant traits">
              {plant.traits.map((trait) => <span>{trait}</span>)}
            </div>
          </div>
        </header>

        <div class="plant-page-grid">
          <section class="detail-panel plant-page-panel">
            <h2>Growing Profile</h2>
            <dl class="plant-page-stats">
              <div><dt>Hardiness</dt><dd>Zones {plant.zones[0]}-{plant.zones[1]}</dd></div>
              <div>
                <dt>Sun</dt>
                <dd class="plant-page-chip-list">{plant.sun.map((value) => <span>{sentenceCase(value)}</span>)}</dd>
              </div>
              <div>
                <dt>Soil</dt>
                <dd class="plant-page-chip-list">{plant.soils.map((value) => <span>{sentenceCase(value)}</span>)}</dd>
              </div>
              <div>
                <dt>Water</dt>
                <dd class="plant-page-chip-list"><span>{sentenceCase(plant.water)}</span></dd>
              </div>
              <div>
                <dt>Goals</dt>
                <dd class="plant-page-chip-list">{plant.goals.map((goal) => <span>{formatGoal(goal)}</span>)}</dd>
              </div>
            </dl>
          </section>

          <section class="detail-panel plant-page-panel">
            <h2>Harvest & Use</h2>
            <dl class="plant-page-stats compact">
              <div><dt>Window</dt><dd>{plant.harvest}</dd></div>
              <div><dt>{primaryReturnLabel}</dt><dd>{primaryReturnValue ?? "Needs source"}</dd></div>
              <div><dt>First output</dt><dd>{metricDisplay.firstOutput ?? "Needs source"}</dd></div>
              <div><dt>Best for</dt><dd class="plant-page-chip-list">{plant.goals.map((goal) => <span>{formatGoal(goal)}</span>)}</dd></div>
            </dl>
            <p>{harvestInsight}</p>
            <div class="plant-page-source-action">
              <span>Source listing: {partnerName}</span>
              {partnerSearchUrl ? (
                <a class="plant-page-action" href={partnerSearchUrl} target="_blank" rel="noopener noreferrer">
                  Search {partnerName}
                </a>
              ) : (
                <span class="nursery-placeholder">Source search coming soon</span>
              )}
            </div>
          </section>

          <section class="detail-panel plant-page-panel">
            <h2>Quantitative Profile</h2>
            <dl class="plant-page-stats compact">
              <div><dt>Pound return</dt><dd>{metricDisplay.yieldLbs ?? "Needs source"}</dd></div>
              <div><dt>10-year return</dt><dd>{metricDisplay.tenYearYieldLbs ?? "Needs source"}</dd></div>
              <div><dt>Full output</dt><dd>{metricDisplay.fullOutput ?? "Needs source"}</dd></div>
              <div><dt>Mature size</dt><dd>{metricDisplay.matureSize ?? "Needs source"}</dd></div>
              <div><dt>Spacing</dt><dd>{metricDisplay.spacing ?? "Needs source"}</dd></div>
              <div><dt>Productive life</dt><dd>{metricDisplay.lifespan ?? "Needs source"}</dd></div>
              <div><dt>Difficulty</dt><dd>{metricDisplay.difficulty ?? "Needs source"}</dd></div>
              <div><dt>Reliability</dt><dd>{metricDisplay.reliability ?? "Needs source"}</dd></div>
              <div><dt>Data quality</dt><dd>{metricDisplay.confidence ?? "Needs review"} profile, {yieldConfidenceLabel}</dd></div>
            </dl>
            <p>
              Pound return is the stock-style yield metric. These are planning ranges for comparing plants, not guarantees. Cultivar,
              rootstock, climate, soil, pruning, pest pressure, and wildlife can move
              actual results.
            </p>
          </section>

          {hasYieldChart && yieldChart && (
            <section class="detail-panel plant-page-yield-chart">
              <div class="yield-chart-head">
                <div>
                  <p class="eyebrow">Yield curve</p>
                  <h2>Estimated Pound Return</h2>
                  <p>
                    Projected annual yield ramp from establishment to full production,
                    using the current sourced range for {plant.name}.
                  </p>
                </div>
                <span>{yieldConfidenceLabel}</span>
              </div>
              <div class="yield-chart-layout">
                <div class="yield-chart-frame">
                  <svg viewBox={yieldChart.viewBox} role="img" aria-label={`${plant.name} estimated yield curve in pounds`}>
                    <defs>
                      <linearGradient id="yield-line-gradient" x1="0" x2="1" y1="0" y2="0">
                        <stop offset="0%" stop-color="#27583a" />
                        <stop offset="100%" stop-color="#df7b4f" />
                      </linearGradient>
                    </defs>
                    {yieldChart.ticks.map((tick) => (
                      <g class="yield-chart-gridline">
                        <line x1="48" x2="620" y1={tick.y} y2={tick.y}></line>
                        <text x="8" y={tick.y + 4}>{tick.label}</text>
                      </g>
                    ))}
                    <polygon class="yield-chart-band" points={yieldChart.bandPoints}></polygon>
                    <text class="yield-chart-band-label" x={yieldChart.bandLabel.x} y={yieldChart.bandLabel.y}>Source range</text>
                    <polyline class="yield-chart-line" points={yieldChart.linePoints}></polyline>
                    <text class="yield-chart-line-label" x={yieldChart.lineLabel.x} y={yieldChart.lineLabel.y}>Expected midpoint</text>
                    {yieldChart.establishmentLabel && (
                      <text class="yield-chart-annotation" x={yieldChart.establishmentLabel.x} y={yieldChart.establishmentLabel.y}>Y1 establishment</text>
                    )}
                    {yieldChart.points.map((point) => (
                      <g class="yield-chart-point">
                        <circle cx={point.x} cy={point.y} r="3.8"></circle>
                        <text x={point.x} y="244">Y{point.year}</text>
                      </g>
                    ))}
                  </svg>
                </div>
                <dl class="yield-chart-stats">
                  <div>
                    <dt>Year 1</dt>
                    <dd>{yieldYearOne ? metricRange(yieldYearOne.min, yieldYearOne.max, " lb") : "Needs source"}</dd>
                    {yieldYearOne && <small>{yieldYearOneNote}</small>}
                  </div>
                  <div><dt>Year 5</dt><dd>{yieldYearFive ? metricRange(yieldYearFive.min, yieldYearFive.max, " lb") : "Needs source"}</dd></div>
                  <div><dt>Year 10</dt><dd>{yieldYearTen ? metricRange(yieldYearTen.min, yieldYearTen.max, " lb") : "Needs source"}</dd></div>
                  <div><dt>10-year total</dt><dd>{metricDisplay.tenYearYieldLbs ?? "Needs source"}</dd></div>
                </dl>
              </div>
              <p class="yield-chart-caption">
                Shaded band shows the sourced low-to-high pound-yield range. The line tracks the midpoint for quick comparison.
              </p>
              <p class="yield-chart-method">
                Method: {metrics.yieldLbsMethod}. Annual crops assume one comparable planting per year;
                perennial crops ramp from first bearing to full production.
              </p>
            </section>
          )}

          <section class="detail-panel plant-page-panel">
            <h2>Planting Strategy</h2>
            <ul class="plant-page-list">
              <li>Start with one plant when testing fit in a new bed or container.</li>
              {hasEdibleGoal && <li>Plant more than one when harvest volume or pollination is the main goal.</li>}
              {plant.goals.includes("privacy-screening") && <li>For screening, repeat compatible plants and confirm mature spacing before buying.</li>}
              {relatedPlantCount > 0 && <li>Use the pairing map below to choose nearby companions or compatible varieties.</li>}
            </ul>
          </section>

          <section class="detail-panel plant-page-panel">
            <h2>Risk Factors</h2>
            <ul class="plant-page-list">
              {planningNotes.map((note) => <li>{note}</li>)}
            </ul>
          </section>

          {comparablePlants.length > 0 && (
            <section class="detail-panel plant-page-comparables">
              <h2>Comparable Plants</h2>
              <div class="plant-comparison-table" role="table" aria-label={`Comparable plants for ${plant.name}`}>
                <div class="plant-comparison-row is-head" role="row">
                  <span role="columnheader">Plant</span>
                  <span role="columnheader">Zones</span>
                  <span role="columnheader">First output</span>
                  <span role="columnheader">Yield (lbs)</span>
                  <span role="columnheader">Difficulty</span>
                  <span role="columnheader">Why it is a peer</span>
                </div>
                {comparablePlants.map(({ candidate, reason }) => {
                  const candidateMetrics = plantMetrics[candidate.id]?.display ?? {};
                  return (
                    <a class="plant-comparison-row" href={plantUrl(candidate)} role="row">
                      <span role="cell"><strong>{candidate.name}</strong></span>
                      <span role="cell" data-label="Zones">{candidate.zones[0]}-{candidate.zones[1]}</span>
                      <span role="cell" data-label="First output">{candidateMetrics.firstOutput ?? "Needs source"}</span>
                      <span role="cell" data-label="Yield (lbs)">{candidateMetrics.yieldLbs ?? "Needs source"}</span>
                      <span role="cell" data-label="Difficulty">{candidateMetrics.difficulty ?? "-"}</span>
                      <span role="cell" data-label="Why peer">{reason}</span>
                    </a>
                  );
                })}
              </div>
            </section>
          )}

          {relationshipEntries.length > 0 && (
            <section class="detail-panel relationship-panel plant-page-relationships">
              <h2>Companion Plants & Pairings</h2>
              <div class="relationship-list">
                {cultivarRelationshipEntries.length > 0 && <h3>Compatible Cultivars</h3>}
                {cultivarRelationshipEntries.map(({ relationship, relatedPlants }) => {
                  const visiblePlants = relatedPlants.slice(0, 8);
                  const moreCount = relatedPlants.length - visiblePlants.length;
                  return (
                    <article class="relationship-item">
                      <div class="relationship-head">
                        <span>{relationshipTypeLabels[relationship.type] ?? sentenceCase(relationship.type)}</span>
                        <strong>{sentenceCase(relationship.strength ?? "noted")}</strong>
                      </div>
                      <p>{relationship.note}</p>
                      <div class="relationship-tags">
                        {visiblePlants.map((relatedPlant) => (
                          <a href={plantUrl(relatedPlant)}>{relatedPlant.name}</a>
                        ))}
                        {moreCount > 0 && <span>+{moreCount} more</span>}
                      </div>
                    </article>
                  );
                })}
                {nearbyRelationshipEntries.length > 0 && <h3>Plant Nearby</h3>}
                {nearbyRelationshipEntries.map(({ relationship, relatedPlants }) => {
                  const visiblePlants = relatedPlants.slice(0, 8);
                  const moreCount = relatedPlants.length - visiblePlants.length;
                  return (
                    <article class="relationship-item">
                      <div class="relationship-head">
                        <span>{relationshipTypeLabels[relationship.type] ?? sentenceCase(relationship.type)}</span>
                        <strong>{sentenceCase(relationship.strength ?? "noted")}</strong>
                      </div>
                      <p>{relationship.note}</p>
                      <div class="relationship-tags">
                        {visiblePlants.map((relatedPlant) => (
                          <a href={plantUrl(relatedPlant)}>{relatedPlant.name}</a>
                        ))}
                        {moreCount > 0 && <span>+{moreCount} more</span>}
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          )}

          <section class="detail-panel plant-page-methodology">
            <h2>Sources & Methodology</h2>
            <p>
              This profile is generated from the Plant by ZIP database: hardiness range,
              light, soil, water, harvest timing, traits, source listing, relationship
              rules, and quantitative planning metrics. Pairings are term-based and reviewed
              to avoid obvious false positives.
            </p>
            <p>
              Quantitative values use extension and botanical-reference ranges where available,
              then crop-family templates when cultivar-level data is not defensible. Ranges are
              intentionally broad to avoid false precision.
            </p>
            {metricSources.length > 0 && (
              <p class="plant-page-source-links">
                <span>Quantitative sources:</span>
                {metricSources.slice(0, 5).map((source) => (
                  <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>
                ))}
              </p>
            )}
            <p>
              Source listing: {partnerName}. Nursery search links are not paid placements
              unless explicitly marked. Last reviewed: {metrics.lastReviewed ?? "May 2026"}.
            </p>
          </section>
        </div>
      </article>
    </main>
    <script>
      document.querySelectorAll("[data-print-profile]").forEach((button) => {
        button.addEventListener("click", () => window.print());
      });
    </script>
  </body>
</html>
