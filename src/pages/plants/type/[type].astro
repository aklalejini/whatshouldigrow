---
import FaviconTags from "../../../components/FaviconTags.astro";
import PrimaryNav from "../../../components/PrimaryNav.astro";
import AnalyticsEvents from "../../../components/AnalyticsEvents.astro";
import PlantCollection from "../../../components/PlantCollection.astro";
import plants from "../../../data/plants.json";
import plantMetrics from "../../../data/plantMetrics.json";
import { DEFAULT_SOCIAL_IMAGE, SITE_NAME, SITE_URL, siteUrl } from "../../../lib/site";
import {
  directoryEntries,
  itemListJsonLd,
  typeBySlug,
  typeGroups
} from "../../../lib/plantDirectory";
import { sentenceCase } from "../../../lib/plantUtils";
import "../../../styles/global.css";

export function getStaticPaths() {
  return typeGroups(plants).map((group) => ({
    params: { type: group.slug },
    props: { group }
  }));
}

const { group } = Astro.props;
const canonicalUrl = siteUrl(`/plants/type/${group.slug}/`);
const entries = directoryEntries(plants, plantMetrics, (plant) => typeBySlug([plant], group.slug) || plant.type.toLowerCase() === group.label.toLowerCase());
const title = `${group.label} Plant Profiles`;
const description = `Browse ${entries.length} ${group.label.toLowerCase()} profiles with Plant by ZIP hardiness, light, soil, water, spacing, timing, and source notes.`;
const socialImageUrl = siteUrl(DEFAULT_SOCIAL_IMAGE);
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: SITE_URL },
    { "@type": "ListItem", position: 2, name: "Plants", item: siteUrl("/plants/") },
    { "@type": "ListItem", position: 3, name: title, item: canonicalUrl }
  ]
};
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: canonicalUrl,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: entries.length,
    itemListElement: itemListJsonLd(entries, siteUrl)
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | ${SITE_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${SITE_NAME}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,750&family=Inter:wght@400;500;650;750;850&display=swap" rel="stylesheet" />
    <FaviconTags />
    <title>{title} | {SITE_NAME}</title>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)}></script>
  </head>
  <body>
    <main class="app-shell">
      <PrimaryNav active="plants" />

      <article class="hub-page">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Plant by ZIP</a><span aria-hidden="true">/</span><a href="/plants/">Plants</a><span aria-hidden="true">/</span><span>{group.label}</span>
        </nav>
        <header class="hub-hero">
          <div>
            <p class="eyebrow">Plant type</p>
            <h1>{title}</h1>
            <p>{description} Open a profile for photos, quantitative ranges, and pairing notes.</p>
            <div class="hub-actions">
              <a class="plant-page-action is-primary" href="/">Match by ZIP</a>
              <a class="plant-page-action is-secondary" href="/plants/">All plant collections</a>
            </div>
          </div>
          <dl class="hub-stats" aria-label={`${title} stats`}>
            <div><dt>{sentenceCase(group.label)}</dt><dd>{entries.length}</dd></div>
          </dl>
        </header>
        <section class="hub-section" aria-labelledby="plant-type-list-title">
          <div class="hub-section-head">
            <div><p class="eyebrow">Profiles</p><h2 id="plant-type-list-title">Browse {group.label.toLowerCase()}</h2></div>
          </div>
          <PlantCollection entries={entries} />
        </section>
      </article>
    </main>
    <AnalyticsEvents pageType="plant_directory" topic={`type:${group.slug}`} />
  </body>
</html>
