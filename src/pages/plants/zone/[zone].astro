---
import AnalyticsEvents from "../../../components/AnalyticsEvents.astro";
import PlantCollection from "../../../components/PlantCollection.astro";
import plants from "../../../data/plants.json";
import plantMetrics from "../../../data/plantMetrics.json";
import { DEFAULT_SOCIAL_IMAGE, SITE_NAME, SITE_URL, siteUrl } from "../../../lib/site";
import {
  directoryEntries,
  itemListJsonLd,
  plantFitsZone,
  zoneGroups
} from "../../../lib/plantDirectory";
import "../../../styles/global.css";

export function getStaticPaths() {
  return zoneGroups(plants).map((group) => ({
    params: { zone: group.slug },
    props: { group }
  }));
}

const { group } = Astro.props;
const canonicalUrl = siteUrl(`/plants/zone/${group.slug}/`);
const entries = directoryEntries(plants, plantMetrics, (plant) => plantFitsZone(plant, group.zone));
const title = `Plants for USDA Zone ${group.zone}`;
const description = `Browse ${entries.length} Plant by ZIP profiles whose database hardiness ranges include USDA zone ${group.zone}.`;
const socialImageUrl = siteUrl(DEFAULT_SOCIAL_IMAGE);
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: SITE_URL },
    { "@type": "ListItem", position: 2, name: "Plants", item: siteUrl("/plants/") },
    { "@type": "ListItem", position: 3, name: title, item: canonicalUrl }
  ]
};
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: canonicalUrl,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: entries.length,
    itemListElement: itemListJsonLd(entries, siteUrl)
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | ${SITE_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${SITE_NAME}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,750&family=Inter:wght@400;500;650;750;850&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/plantbyzip-icon.png" />
    <link rel="apple-touch-icon" href="/brand/plantbyzip-icon.png" />
    <title>{title} | {SITE_NAME}</title>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)}></script>
  </head>
  <body>
    <main class="app-shell">
      <nav class="site-tabs" aria-label="Primary sections">
        <a class="site-tab" href="/">Plant matcher</a>
        <a class="site-tab" href="/#screener">Screener</a>
        <a class="site-tab" href="/planting-calendar/">Calendar</a>
        <a class="site-tab" href="/#zone-map">Zone map</a>
        <a class="site-tab is-active" aria-current="page" href="/plants/">Plants</a>
        <a class="site-tab" href="/blog/">Guides</a>
      </nav>

      <article class="hub-page">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Plant by ZIP</a><span aria-hidden="true">/</span><a href="/plants/">Plants</a><span aria-hidden="true">/</span><span>Zone {group.zone}</span>
        </nav>
        <header class="hub-hero">
          <div>
            <p class="eyebrow">Hardiness collection</p>
            <h1>{title}</h1>
            <p>{description} Hardiness is only the first gate; use ZIP lookup for frost context, heat, and site conditions.</p>
            <div class="hub-actions">
              <a class="plant-page-action is-primary" href="/">Match by ZIP</a>
              <a class="plant-page-action is-secondary" href="/plants/">All plant collections</a>
            </div>
          </div>
          <dl class="hub-stats" aria-label={`${title} stats`}>
            <div><dt>Zone {group.zone}</dt><dd>{entries.length}</dd></div>
          </dl>
        </header>
        <section class="hub-section" aria-labelledby="plant-zone-list-title">
          <div class="hub-section-head">
            <div><p class="eyebrow">Profiles</p><h2 id="plant-zone-list-title">Browse zone {group.zone} plants</h2></div>
          </div>
          <PlantCollection entries={entries} />
        </section>
      </article>
    </main>
    <AnalyticsEvents pageType="plant_directory" topic={`zone:${group.zone}`} zone={group.zone} />
  </body>
</html>
