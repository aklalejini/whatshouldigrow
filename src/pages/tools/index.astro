---
import PrimaryNav from "../../components/PrimaryNav.astro";
import AnalyticsEvents from "../../components/AnalyticsEvents.astro";
import { DEFAULT_SOCIAL_IMAGE, SITE_NAME, SITE_URL, siteUrl } from "../../lib/site";
import { toolInternalLinks } from "../../lib/toolData";
import "../../styles/global.css";

const tools = toolInternalLinks();
const canonicalUrl = siteUrl("/tools/");
const description = "Use Plant by ZIP's practical garden tools for planting timing, pest triage, companion checks, container sizing, and drip irrigation planning.";
const socialImageUrl = siteUrl(DEFAULT_SOCIAL_IMAGE);
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: SITE_URL },
    { "@type": "ListItem", position: 2, name: "Tools", item: canonicalUrl }
  ]
};
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Garden Tools",
  description,
  url: canonicalUrl,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: tools.map((tool, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: tool.title,
      url: siteUrl(tool.href)
    }))
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`Garden Tools | ${SITE_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`Garden Tools | ${SITE_NAME}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,750&family=Inter:wght@400;500;650;750;850&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/plantbyzip-icon.png" />
    <link rel="apple-touch-icon" href="/brand/plantbyzip-icon.png" />
    <title>Garden Tools | {SITE_NAME}</title>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)}></script>
  </head>
  <body>
    <main class="app-shell">
      <PrimaryNav active="tools" />

      <article class="hub-page">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Plant by ZIP</a>
          <span aria-hidden="true">/</span>
          <span>Tools</span>
        </nav>
        <header class="hub-hero">
          <div>
            <p class="eyebrow">Shareable tools</p>
            <h1>Garden tools for the questions people ask every week.</h1>
            <p>{description}</p>
            <div class="hub-actions">
              <a class="plant-page-action is-primary" href="/what-to-plant-this-week/">Check what to plant now</a>
              <a class="plant-page-action is-secondary" href="/garden-plans/">Browse bed templates</a>
            </div>
          </div>
          <dl class="hub-stats" aria-label="Tool stats">
            <div><dt>Tools</dt><dd>{tools.length}</dd></div>
            <div><dt>Data</dt><dd>Database-backed</dd></div>
          </dl>
        </header>

        <section class="hub-section" aria-labelledby="tool-list-title">
          <div class="hub-section-head">
            <div>
              <p class="eyebrow">Pick a question</p>
              <h2 id="tool-list-title">Practical garden calculators and checkers</h2>
            </div>
            <p>Each tool keeps product links labeled and separate from the answer.</p>
          </div>
          <div class="home-hub-grid">
            {tools.map((tool) => (
              <a href={tool.href}>
                <span>{tool.title}</span>
                <strong>{tool.description}</strong>
              </a>
            ))}
          </div>
        </section>
      </article>
    </main>
    <AnalyticsEvents pageType="tools_index" topic="tools" />
  </body>
</html>
